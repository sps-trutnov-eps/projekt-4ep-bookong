@using Bookong.Web.Components.Layout
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.DTOs
@using Bookong.Application.UseCases.Interfaces
@using Bookong.Domain.Interfaces
@using Microsoft.JSInterop
@page "/loans"
@layout MainLayout
@inject IGetAllBookLoansQuery GetAllBookLoans
@inject IGetBookLoanStatusQuery GetBookLoanStatus
@inject ICreateBookLoanUseCase CreateBookLoan
@inject IReturnBookUseCase ReturnBook
@inject IProlongBookLoanUseCase ProlongBookLoan
@inject IUnitOfWork _uow
@inject IJSRuntime JS
@inject ILogger<Loans> Logger
@implements IAsyncDisposable

<div class="bg-white pb-5" style="min-height: 80vh;">
    <div class="container px-4 pt-5">
        <!-- Page Header -->
        <div class="text-center mb-5">
            <h1 class="fw-bold text-primary mb-3" style="font-size: 3rem; letter-spacing: -0.02em;">
                Výpůjčky knih
            </h1>
            <p class="lead text-muted" style="font-size: 1.1rem;">
                Přehled výpůjček v knihovně
            </p>
            
            <!-- QR Scanner and Manual Input Buttons -->
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center mt-3">
                <button class="btn btn-primary btn-lg" @onclick="OpenQrScanner">
                    <i class="bi bi-qr-code-scan me-2"></i>Skenovat QR kód knihy
                </button>
                <button class="btn btn-outline-primary btn-lg" @onclick="OpenManualInput">
                    <i class="bi bi-keyboard me-2"></i>Zadat ID ručně
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Načítání...</span>
                </div>
            </div>
        }
        else if (bookLoans == null || !bookLoans.Any())
        {
            <div class="text-center py-5">
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Žádné výpůjčky nebyly nalezeny.
                </div>
            </div>
        }
        else
        {
            <!-- Filter Tabs -->
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(currentFilter == LoanFilter.Active ? "active" : "")" 
                            @onclick="() => SetFilter(LoanFilter.Active)">
                        Aktuální (@activeLoansCount)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(currentFilter == LoanFilter.Returned ? "active" : "")" 
                            @onclick="() => SetFilter(LoanFilter.Returned)">
                        Vrácené (@returnedLoansCount)
                    </button>
                </li>
            </ul>

            <!-- Book Loans Table -->
            <div class="border rounded-3 shadow-sm bg-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:5%">#</th>
                                <th>Název knihy</th>
                                <th class="d-none d-lg-table-cell">Autor</th>
                                <th class="d-none d-md-table-cell">Čtenář</th>
                                <th class="d-none d-xl-table-cell">Email</th>
                                <th>Datum vypůjčení</th>
                                <th>Datum vrácení</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var pagedLoans = GetPagedLoans();
                                for (int i = 0; i < pagedLoans.Count; i++)
                                {
                                    var loan = pagedLoans[i];
                                    var globalIndex = (currentPage - 1) * pageSize + i + 1;
                                    <tr>
                                        <td>@globalIndex</td>
                                        <td class="fw-medium">@loan.BookTitle</td>
                                        <td class="d-none d-lg-table-cell text-muted">@loan.BookAuthor</td>
                                        <td class="d-none d-md-table-cell">@loan.UserFullName</td>
                                        <td class="d-none d-xl-table-cell text-muted">@loan.UserEmail</td>
                                        <td>
                                            <small class="text-muted">
                                                @loan.LoanDate.ToLocalTime().ToString("dd.MM.yyyy")
                                            </small>
                                        </td>
                                        <td>
                                            @if (loan.IsReturned)
                                            {
                                                <small class="text-muted">
                                                    @loan.ReturnDate!.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                                </small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (loan.IsReturned)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Vráceno
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-book me-1"></i>Aktivní
                                                </span>
                                                <br />
                                                <small class="text-muted">(@loan.DaysLoaned dnů)</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center p-3 border-top">
                        <div class="text-muted small">
                            Zobrazeno @((currentPage - 1) * pageSize + 1) - @Math.Min(currentPage * pageSize, GetFilteredLoans().Count) z @GetFilteredLoans().Count
                        </div>
                        <nav aria-label="Navigace stránkování výpůjček">
                            <ul class="pagination mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                </li>
                                
                                @if (GetStartPage() > 1)
                                {
                                    <li class="page-item">
                                        <button class="page-link" @onclick="() => ChangePage(1)">1</button>
                                    </li>
                                    @if (GetStartPage() > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                @for (int page = GetStartPage(); page <= GetEndPage(); page++)
                                {
                                    var pageNumber = page;
                                    <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                        <button class="page-link" @onclick="() => ChangePage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    </li>
                                }

                                @if (GetEndPage() < totalPages)
                                {
                                    @if (GetEndPage() < totalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <button class="page-link" @onclick="() => ChangePage(totalPages)">@totalPages</button>
                                    </li>
                                }
                                
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Wave Container -->
<div class="position-relative w-100 overflow-hidden" style="line-height: 0;">
    <!-- Primary Wave -->
    <svg class="w-100 d-block" style="height: 5rem;" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 C300,80 900,0 1200,80 L1200,120 L0,120 Z" fill="#0a4db8"></path>
    </svg>
    <!-- Secondary Wave -->
    <svg class="w-100 d-block" style="height: 5rem; margin-top: -0.25rem; background-color: #0a4db8;" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 C400,60 800,0 1200,60 L1200,120 L0,120 Z" fill="#083d96"></path>
    </svg>
</div>

<!-- QR Scanner Modal -->
@if (showQrScanner)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Skenovat QR kód knihy</h5>
                    <button type="button" class="btn-close" @onclick="CloseQrScanner"></button>
                </div>
                <div class="modal-body text-center">
                    @if (scannerError != null)
                    {
                        <div class="alert alert-danger">@scannerError</div>
                    }
                    <video id="qr-video" style="width: 100%; max-width: 500px; border: 2px solid #0a4db8; border-radius: 8px;"></video>
                    <p class="text-muted mt-3">Namiřte kameru na QR kód knihy</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseQrScanner">Zrušit</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Book Action Modal -->
@if (showBookActionModal && scannedBook != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detail knihy</h5>
                    <button type="button" class="btn-close" @onclick="CloseBookActionModal"></button>
                </div>
                <div class="modal-body">
                    @if (actionMessage != null)
                    {
                        <div class="alert @(actionSuccess ? "alert-success" : "alert-danger") alert-dismissible">
                            @actionMessage
                            <button type="button" class="btn-close" @onclick="() => actionMessage = null"></button>
                        </div>
                    }
                    
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <h4 class="card-title text-primary">@scannedBook.BookTitle</h4>
                            <p class="card-text">
                                <strong>Autor:</strong> @scannedBook.BookAuthor<br />
                                <strong>Žánr:</strong> @scannedBook.Genre
                            </p>
                            
                            @if (scannedBook.IsCurrentlyLoaned)
                            {
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle me-2"></i>
                                    <strong>Aktuálně vypůjčeno</strong><br />
                                    Vypůjčil: @scannedBook.CurrentBorrowerName<br />
                                    Datum vypůjčení: @scannedBook.LoanDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")<br />
                                    Vypůjčeno po dobu: @scannedBook.DaysLoaned dnů
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Kniha je k dispozici k vypůjčení
                                </div>
                            }
                        </div>
                    </div>

                    @if (scannedBook.IsCurrentlyLoaned)
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-success flex-fill" @onclick="ReturnScannedBook" disabled="@isProcessing">
                                <i class="bi bi-arrow-return-left me-2"></i>Vrátit knihu
                            </button>
                            <button class="btn btn-primary flex-fill" @onclick="ProlongScannedBook" disabled="@isProcessing">
                                <i class="bi bi-clock-history me-2"></i>Prodloužit o 14 dní
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Vyberte uživatele</label>
                            <select class="form-select" @bind="selectedUserId">
                                <option value="0">-- Vyberte uživatele --</option>
                                @foreach (var user in availableUsers)
                                {
                                    <option value="@user.Id">@user.Name (@user.Email)</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-primary w-100" @onclick="LendScannedBook" disabled="@(isProcessing || selectedUserId == 0)">
                            <i class="bi bi-book me-2"></i>Vypůjčit knihu
                        </button>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseBookActionModal">Zavřít</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Manual Input Modal -->
@if (showManualInput)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Zadat ID knihy ručně</h5>
                    <button type="button" class="btn-close" @onclick="CloseManualInput"></button>
                </div>
                <div class="modal-body">
                    @if (manualInputError != null)
                    {
                        <div class="alert alert-danger alert-dismissible">
                            @manualInputError
                            <button type="button" class="btn-close" @onclick="() => manualInputError = null"></button>
                        </div>
                    }
                    <div class="mb-3">
                        <label for="publicIdInput" class="form-label">PublicId knihy (GUID)</label>
                        <input type="text" 
                               class="form-control" 
                               id="publicIdInput" 
                               @bind="manualPublicIdInput" 
                               placeholder="např. 12345678-1234-1234-1234-123456789abc"
                               @onkeypress="HandleManualInputKeyPress" />
                        <small class="form-text text-muted">
                            Zadejte PublicId knihy ve formátu GUID
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseManualInput">Zrušit</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitManualInput" disabled="@(string.IsNullOrWhiteSpace(manualPublicIdInput))">
                        <i class="bi bi-search me-2"></i>Vyhledat knihu
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BookLoanListItemDto> bookLoans = new();
    private bool isLoading = true;
    private string? errorMessage;
    private LoanFilter currentFilter = LoanFilter.Active;
    private int currentPage = 1;
    private const int pageSize = 6;

    private int activeLoansCount => bookLoans.Count(bl => !bl.IsReturned);
    private int returnedLoansCount => bookLoans.Count(bl => bl.IsReturned);
    private int totalPages => (int)Math.Ceiling(GetFilteredLoans().Count / (double)pageSize);

    private bool showQrScanner = false;
    private bool showBookActionModal = false;
    private bool showManualInput = false;
    private string? scannerError;
    private string? manualInputError;
    private string? actionMessage;
    private bool actionSuccess;
    private BookLoanStatusDto? scannedBook;
    private int selectedUserId = 0;
    private List<UserDto> availableUsers = new();
    private bool isProcessing = false;
    private DotNetObjectReference<Loans>? dotNetRef;
    private string manualPublicIdInput = string.Empty;

    private enum LoanFilter
    {
        Active,
        Returned
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var loans = await GetAllBookLoans.ExecuteAsync();
            bookLoans = loans?.ToList() ?? new();
            
            await LoadAvailableUsers();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading book loans");
            errorMessage = "Nepodařilo se načíst výpůjčky knih.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadAvailableUsers()
    {
        try
        {
            var users = await _uow.Users.GetAllAsync();
            availableUsers = users.Select(u => new UserDto 
            { 
                Id = u.Id, 
                Name = u.Name, 
                Email = u.Email 
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading users");
        }
    }

    private async Task OpenQrScanner()
    {
        showQrScanner = true;
        scannerError = null;
        StateHasChanged();
        
        await Task.Delay(100);
        
        try
        {
            dotNetRef = DotNetObjectReference.Create(this);
            var success = await JS.InvokeAsync<bool>("qrScanner.startScanner", "qr-video", dotNetRef);
            
            if (!success)
            {
                scannerError = "Nepodařilo se spustit skenování QR kódu.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting QR scanner");
            scannerError = "Chyba při spuštění skeneru: " + ex.Message;
        }
    }

    private async Task CloseQrScanner()
    {
        try
        {
            await JS.InvokeVoidAsync("qrScanner.stopScanner");
        }
        catch { }
        
        showQrScanner = false;
        scannerError = null;
        dotNetRef?.Dispose();
        dotNetRef = null;
    }

    private void OpenManualInput()
    {
        showManualInput = true;
        manualInputError = null;
        manualPublicIdInput = string.Empty;
    }

    private void CloseManualInput()
    {
        showManualInput = false;
        manualInputError = null;
        manualPublicIdInput = string.Empty;
    }

    private async Task HandleManualInputKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(manualPublicIdInput))
        {
            await SubmitManualInput();
        }
    }

    private async Task SubmitManualInput()
    {
        if (string.IsNullOrWhiteSpace(manualPublicIdInput))
            return;

        if (Guid.TryParse(manualPublicIdInput.Trim(), out var bookPublicId))
        {
            CloseManualInput();
            await LoadBookDetails(bookPublicId);
        }
        else
        {
            manualInputError = "Neplatný formát ID. Zadejte prosím platný GUID (např. 12345678-1234-1234-1234-123456789abc).";
        }
    }

    private async Task LoadBookDetails(Guid bookPublicId)
    {
        try
        {
            scannedBook = await GetBookLoanStatus.ExecuteAsync(bookPublicId);
            
            if (scannedBook == null)
            {
                actionMessage = "Kniha nebyla nalezena.";
                actionSuccess = false;
            }
            else
            {
                showBookActionModal = true;
                actionMessage = null;
                selectedUserId = 0;
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading book details");
            actionMessage = "Chyba při načítání informací o knize.";
            actionSuccess = false;
        }
    }

    private async Task LendScannedBook()
    {
        if (selectedUserId == 0 || scannedBook == null)
            return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var dto = new CreateBookLoanDto
            {
                BookId = scannedBook.BookId,
                UserId = selectedUserId
            };

            var response = await CreateBookLoan.ExecuteAsync(dto);
            actionMessage = response.Message;
            actionSuccess = response.Success;

            if (response.Success)
            {
                await RefreshLoans();
                await Task.Delay(2000);
                await CloseBookActionModal();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error lending book");
            actionMessage = "Chyba při vypůjčování knihy.";
            actionSuccess = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ReturnScannedBook()
    {
        if (scannedBook == null)
            return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var response = await ReturnBook.ExecuteAsync(scannedBook.BookPublicId);
            actionMessage = response.Message;
            actionSuccess = response.Success;

            if (response.Success)
            {
                await RefreshLoans();
                await Task.Delay(2000);
                await CloseBookActionModal();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error returning book");
            actionMessage = "Chyba při vracení knihy.";
            actionSuccess = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ProlongScannedBook()
    {
        if (scannedBook == null)
            return;

        isProcessing = true;
        StateHasChanged();

        try
        {
            var dto = new ProlongBookLoanDto
            {
                BookPublicId = scannedBook.BookPublicId,
                DaysToProlong = 14
            };

            var response = await ProlongBookLoan.ExecuteAsync(dto);
            actionMessage = response.Message;
            actionSuccess = response.Success;

            if (response.Success)
            {
                await RefreshLoans();
                await Task.Delay(2000);
                await CloseBookActionModal();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error prolonging loan");
            actionMessage = "Chyba při prodlužování výpůjčky.";
            actionSuccess = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task RefreshLoans()
    {
        try
        {
            var loans = await GetAllBookLoans.ExecuteAsync();
            bookLoans = loans?.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing loans");
        }
    }

    private async Task CloseBookActionModal()
    {
        showBookActionModal = false;
        scannedBook = null;
        actionMessage = null;
        selectedUserId = 0;
        StateHasChanged();
    }

    private void SetFilter(LoanFilter filter)
    {
        currentFilter = filter;
        currentPage = 1;
        StateHasChanged();
    }

    private List<BookLoanListItemDto> GetFilteredLoans()
    {
        return bookLoans.Where(bl => 
            (currentFilter == LoanFilter.Active && !bl.IsReturned) || 
            (currentFilter == LoanFilter.Returned && bl.IsReturned)
        ).ToList();
    }

    private List<BookLoanListItemDto> GetPagedLoans()
    {
        return GetFilteredLoans()
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private int GetStartPage()
    {
        return Math.Max(1, currentPage - 2);
    }

    private int GetEndPage()
    {
        return Math.Min(totalPages, currentPage + 2);
    }

    private void ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > totalPages)
            return;

        currentPage = newPage;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnQRCodeScanned(string qrData)
    {
        await CloseQrScanner();
        
        if (Guid.TryParse(qrData, out var bookPublicId))
        {
            await LoadBookDetails(bookPublicId);
        }
        else
        {
            actionMessage = "Neplatný QR kód. Zkuste to prosím znovu.";
            actionSuccess = false;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (showQrScanner)
        {
            await CloseQrScanner();
        }
        
        dotNetRef?.Dispose();
    }
}
