@using Bookong.Web.Components.Layout
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.DTOs
@using Microsoft.AspNetCore.WebUtilities

@page "/qrcodegenerator"
@layout MainLayout
@inject IGetBookDetailQuery GetBookDetail
@inject NavigationManager Navigation

<PageTitle>@(bookDetail != null ? $"QR kód pro {bookDetail.Title} - BooKong" : "Přidání knihy — QR generátor - BooKong")</PageTitle>

<style>
  @@media print {
    body * { visibility: hidden; }
    .print-area, .print-area * { visibility: visible; }
    .print-area { position: absolute; left: 0; top: 0; width: 100%; }
    .no-print { display: none !important; }
  }
  .qr-box {
    display: inline-block;
    padding: 16px;
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 1px 6px rgba(0,0,0,0.08);
  }
  .field-help { font-size: .875rem; color: #6c757d; }
</style>

<!-- Main -->
<main class="container my-5 flex-grow-1 d-flex justify-content-center align-items-start">
  <div class="w-100" style="max-width: 900px;">
    <h2 class="mb-4 text-primary text-center">@(bookDetail != null ? $"QR kód pro knihu: {bookDetail.Title}" : "Přidání knihy — vytvoření QR kódu")</h2>

    <div class="card mb-4">
      <div class="card-body">
        <form id="book-form" class="row g-3" novalidate>
          <div class="col-md-8">
            <label for="title" class="form-label">Název</label>
            <input id="title" name="title" class="form-control" required @((bookDetail != null ? "readonly" : "")) />
            <div class="field-help">@(bookDetail != null ? "Údaje knihy jsou předvyplněné a nelze měnit" : "Zadejte celý název literárního díla")</div>
          </div>

          <div class="col-md-4">
            <label for="century" class="form-label">Století</label>
            <input id="century" name="century" type="number" min="1" max="21" class="form-control" @((bookDetail != null ? "readonly" : "")) />
            <div class="field-help">@(bookDetail != null ? "Údaje knihy jsou předvyplněné a nelze měnit" : "Zadejte číslo století")</div>
          </div>

          <div class="col-md-6">
            <label for="author" class="form-label">Autor</label>
            <input id="author" name="author" class="form-control" @((bookDetail != null ? "readonly" : "")) />
            <div class="field-help">@(bookDetail != null ? "Údaje knihy jsou předvyplněné a nelze měnit" : "Zadejte celé jméno autora")</div>
          </div>

          <div class="col-md-6">
            <label for="isbn" class="form-label">ISBN</label>
            <input id="isbn" name="isbn" class="form-control" @((bookDetail != null ? "readonly" : "")) />
            <div class="field-help">@(bookDetail != null ? "Údaje knihy jsou předvyplněné a nelze měnit" : "Zadejte ISBN (volitelné)")</div>
          </div>

          <div class="col-md-4">
            <label for="literature" class="form-label">Literatura</label>
            <select id="literature" name="literature" class="form-select" @((bookDetail != null ? "disabled" : ""))>
              <option value="ceska" selected>Česká</option>
              <option value="svetova">Světová</option>
            </select>
              <div class="field-help">@(bookDetail != null ? "Údaje knihy jsou předvyplněné a nelze měnit" : "Vyberte druh literatury")</div>
          </div>

          <div class="col-12 d-flex gap-2 justify-content-end no-print">
            <button type="button" id="generate-btn" class="btn btn-primary">@(bookDetail != null ? "Vygenerovat QR kód" : "Vytvořit QR kód")</button>
            <button type="button" id="clear-btn" class="btn btn-outline-secondary" @(bookDetail != null ? "disabled" : "")>Vymazat</button>
            <button type="button" id="print-btn" class="btn btn-success">Tisk</button>
          </div>
        </form>
      </div>
    </div>

    <section id="preview" aria-live="polite" class="text-center">
      <p class="text-muted">Náhled QR kódu a údajů o knize</p>

      <div class="print-area d-inline-block text-center p-3">
        <div id="qrcode-wrap" class="qr-box mb-3">
          <!-- QR kód se vygeneruje sem -->
          <div id="qrcode" aria-hidden="true"></div>
        </div>

        <div id="book-summary" class="text-start">
          <!-- Textové údaje se sem doplní -->
          <h5 id="summary-title" class="mb-1"></h5>
          <div id="summary-meta" class="text-muted small"></div>
          <div id="summary-extra" class="mt-2 small"></div>
        </div>
      </div>
    </section>
  </div>
</main>

@code {
    private BookDetailDto? bookDetail;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("bookId", out var bookIdStr))
        {
            if (Guid.TryParse(bookIdStr, out var bookId))
            {
                bookDetail = await GetBookDetail.ExecuteAsync(bookId);
                if (bookDetail != null)
                {
                    // Pre-fill form with book details
                    await InvokeAsync(async () =>
                    {
                        await Task.Delay(100); // Wait for DOM to render
                        // Note: Actual pre-filling will be done in JavaScript after component renders
                    });
                }
            }
        }
    }
}

<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.1/build/qrcode.min.js"></script>
<script>
  (function(){
    const el = id => document.getElementById(id);
    const form = el('book-form');
    const generateBtn = el('generate-btn');
    const clearBtn = el('clear-btn');
    const printBtn = el('print-btn');
    const qrcodeEl = el('qrcode');
    const summaryTitle = el('summary-title');
    const summaryMeta = el('summary-meta');
    const summaryExtra = el('summary-extra');

    // Předvyplnění formuláře, pokud jsou k dispozici údaje o knize
    const bookDetailJson = '@System.Text.Json.JsonSerializer.Serialize(bookDetail)';
    if (bookDetailJson && bookDetailJson !== 'null') {
        const bookDetail = JSON.parse(bookDetailJson);
        el('title').value = bookDetail.title || '';
        el('author').value = bookDetail.authorFullName || '';
        el('isbn').value = bookDetail.isbn || '';
        // Mapování století z periodName (např. "20. století" -> "20")
        if (bookDetail.periodName) {
            const centuryMatch = bookDetail.periodName.match(/(\d+)\. století/);
            if (centuryMatch) {
                el('century').value = centuryMatch[1];
            }
        }
        // Mapování literatury z kindName (např. "Česká" -> "ceska", "Světová" -> "svetova")
        if (bookDetail.kindName === 'Česká') {
            el('literature').value = 'ceska';
        } else if (bookDetail.kindName === 'Světová') {
            el('literature').value = 'svetova';
        }
        // Rok z dateRelease
        if (bookDetail.dateRelease) {
            el('year').value = new Date(bookDetail.dateRelease).getFullYear().toString();
        }
        // Publisher
        el('publisher').value = bookDetail.publisherName || '';
    }

    function collectData() {
      return {
        title: el('title').value.trim(),
        author: el('author').value.trim(),
        isbn: el('isbn').value.trim(),
        publisher: el('publisher').value.trim(),
        literature: el('literature').value,     // přidané pole
        year: el('year').value.trim(),
        century: el('century').value.trim(),    // přidané pole
        shelf: el('shelf').value.trim(),
        note: el('note').value.trim()
      };
    }

    function buildPayload(data) {
      // Payload je JSON pro pozdější backend; přidaná pole literatura a století
      // Zajistit, že století není větší než 21
      let centuryVal = data.century ? parseInt(data.century, 10) : undefined;
      if (!isNaN(centuryVal)) {
        centuryVal = Math.min(21, Math.max(1, centuryVal));
      } else {
        centuryVal = undefined;
      }

      return JSON.stringify({
        title: data.title,
        author: data.author,
        isbn: data.isbn,
        publisher: data.publisher,
        literature: data.literature,
        year: data.year,
        century: centuryVal,
        shelf: data.shelf,
        note: data.note
      });
    }

    function renderSummary(data) {
      summaryTitle.textContent = data.title || '—';
      let meta = [];
      if (data.author) meta.push(data.author);
      if (data.publisher) meta.push(data.publisher);
      if (data.year) meta.push(data.year);
      if (data.century) meta.push(data.century + '. století');
      summaryMeta.textContent = meta.join(' • ');

      const extras = [];
      if (data.isbn) extras.push('ISBN: ' + data.isbn);
      if (data.literature) extras.push('Literatura: ' + (data.literature === 'ceska' ? 'Česká' : data.literature === 'svetova' ? 'Světová' : data.literature));
      if (data.shelf) extras.push('Polička: ' + data.shelf);
      if (data.note) extras.push('Pozn.: ' + data.note);
      summaryExtra.textContent = extras.join(' | ');
    }

    async function generateQr() {
      const data = collectData();
      if (!data.title) {
        alert('Název je povinný.');
        el('title').focus();
        return;
      }

      // validace století pokud je zadané
      if (data.century) {
        const c = parseInt(data.century, 10);
        if (isNaN(c) || c < 1) {
          alert('Zadejte platné století (číslo >= 1).');
          el('century').focus();
          return;
        }
        if (c > 21) {
          alert('Století může být max. 21. Hodnota byla omezena.');
          el('century').value = '21';
          data.century = '21';
        }
      }

      // použít JSON payload — je strukturovaný a snadno parsovatelný
      const payload = buildPayload(data);

      // vymazat starý QR
      qrcodeEl.innerHTML = '';
      try {
        await QRCode.toCanvas(qrcodeEl, payload, { width: 240, margin: 2, color: { dark: '#000000', light: '#ffffff' } });
      } catch (e) {
        // fallback na generování jako SVG/ASCII
        try { QRCode.toString(payload, { type: 'svg' }, function(err, svg){ qrcodeEl.innerHTML = svg || ''; }); } catch(err) {}
      }

      renderSummary(data);
    }

    generateBtn.addEventListener('click', generateQr);
    clearBtn.addEventListener('click', function(){
      form.reset();
      qrcodeEl.innerHTML = '';
      summaryTitle.textContent = '';
      summaryMeta.textContent = '';
      summaryExtra.textContent = '';
    });
    printBtn.addEventListener('click', function(){
      // pokud QR není přítomen, vygenerovat ho před tiskem
      if (!qrcodeEl.querySelector('canvas') && !qrcodeEl.querySelector('svg')) {
        generateQr().then(() => window.print());
      } else {
        window.print();
      }
    });

    // Enter v poli -> vytvořit QR
    form.addEventListener('submit', function(e){ e.preventDefault(); generateQr(); });
  })();
</script>
