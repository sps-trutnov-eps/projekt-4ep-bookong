@page "/maturita"

<section class="books-container">
    <h2>📚 Seznam knih (maturitní knihy)</h2>

    <!-- 🔍 Filtr -->
    <div class="filter-bar">
        <input type="text" placeholder="Hledat knihu nebo autora..." class="filter-input" />
        <select class="filter-select">
            <option>Všechny žánry</option>
            <option>Fantasy</option>
            <option>Sci-fi</option>
            <option>Detektivka</option>
            <option>Román</option>
        </select>
        <button class="filter-button">Hledat</button>
    </div>

    <!-- 📖 Seznam knih -->
    <div class="books-header">
        <span class="col id">#</span>
        <span class="col title">Název</span>
        <span class="col author">Autor</span>
        <span class="col year">Rok vydání</span>
        <span class="col genre">Žánr</span>
    </div>

    @for (int i = 1; i <= 12; i++)
    {
        <details class="book-row">
            <summary class="book-summary">
                <span class="col id">@i</span>
                <span class="col title">Kniha @i</span>
                <span class="col author">Autor @i</span>
                <span class="col year">@(2020 + (i % 5))</span>
                <span class="col genre">@(i % 3 == 0 ? "Fantasy" : i % 3 == 1 ? "Sci-fi" : "Román")</span>
            </summary>
            <div class="book-details">
                <p><strong>Autor:</strong> Autor @i</p>
                <p><strong>Rok vydání:</strong> @(2020 + (i % 5))</p>
                <p><strong>Žánr:</strong> @(i % 3 == 0 ? "Fantasy" : i % 3 == 1 ? "Sci-fi" : "Román")</p>
                <p><strong>Počet stran:</strong> @(250 + i * 10)</p>
                <p><strong>Popis:</strong> Ukázkový popis knihy číslo @i, maturitní literatura.</p>
            </div>
        </details>
    }
</section>

<style>
    .books-container {
        padding: 2rem;
        max-width: 1600px;
        margin: 0 auto;
        font-family: system-ui, sans-serif;
    }

    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    /* 🔍 Filtr */
    .filter-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .filter-input, .filter-select, .filter-button {
        padding: 0.6rem 1rem;
        border-radius: 8px;
        font-size: 1rem;
    }

    .filter-input, .filter-select {
        border: 1px solid #ccc;
    }

    .filter-button {
        background-color: #4f46e5;
        color: white;
        border: none;
        cursor: pointer;
        transition: background 0.2s;
    }

        .filter-button:hover {
            background-color: #4338ca;
        }

    /* 📖 Hlavička a řádky */
    .books-header, .book-summary {
        display: grid;
        grid-template-columns: 60px 35% 30% 120px 120px;
        align-items: center;
        padding: 0.6rem 1rem;
        box-sizing: border-box;
        font-weight: 600;
    }

    .books-header {
        background-color: #f0f0f0;
        border-bottom: 2px solid #ddd;
    }

    .book-row {
        border-bottom: 1px solid #eee;
    }

    .book-summary {
        cursor: pointer;
        font-weight: 400;
        transition: background 0.2s;
    }

        .book-summary:hover {
            background-color: #f9f9f9;
        }

    details[open] .book-summary {
        background-color: #eef;
    }

    .book-details {
        padding: 1rem 2rem;
        background-color: #fafafa;
        border-top: 1px solid #ddd;
    }

    details summary::-webkit-details-marker {
        display: none;
    }

    /* 📱 Responzivní verze */

    /* --- TABLET --- */
    @@media (max-width: 1024px) {
        .books-header, .book-summary

    {
        grid-template-columns: 50px 40% 30% 1fr;
    }

    .col.genre {
        display: none;
    }

    }

    /* --- MENŠÍ TABLET / VODOROVNÝ MOBIL --- */
    @@media (max-width: 768px) {
        .books-header, .book-summary

    {
        grid-template-columns: 50px 1fr 1fr;
    }

    .col.year, .col.genre {
        display: none;
    }

    }

    /* --- MOBIL --- */
    @@media (max-width: 600px) {
        .books-header, .book-summary

    {
        grid-template-columns: 50px 1fr;
    }

    .col.author, .col.year, .col.genre {
        display: none;
    }

    .filter-bar {
        flex-direction: column;
        align-items: stretch;
    }

    .filter-button {
        width: 100%;
    }

    .books-container {
        padding: 1rem;
    }

    }
</style>
