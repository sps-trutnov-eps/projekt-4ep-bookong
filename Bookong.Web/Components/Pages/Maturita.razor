@page "/maturita"
@using Bookong.Web.Services
@inject MaturitaService MaturitaService

<div class="container-fluid py-4 px-0">
    <h1 class="display-6 fw-semibold mb-4 text-center">Maturitní knihy</h1>

    <!-- Seznam knih -->
    <div class="px-3">
        <div class="row bg-light p-3 border-bottom fw-bold mb-2 mx-0">
            <div class="col-1">#</div>
            <div class="col-md-4 col-5">Název</div>
            <div class="col-md-3 d-none d-md-block">Autor</div>
            <div class="col-md-2 d-none d-lg-block">Žánr</div>
            <div class="col-md-2 d-none d-xl-block">Typ</div>
        </div>

        @if (MaturitaService.GetBooks().Count == 0)
        {
            <p class="text-muted px-3">Žádné knihy k maturitě.</p>
        }
        else
        {
            int index = 1;
            foreach (var b in MaturitaService.GetBooks())
            {
                <details class="border-bottom">
                    <summary class="row p-3 bg-white user-select-none mx-0">
                        <div class="col-1">@index</div>
                        <div class="col-md-4 col-5">@b.Title</div>
                        <div class="col-md-3 d-none d-md-block">@b.AuthorFullName</div>
                        <div class="col-md-2 d-none d-lg-block">@b.Genre</div>
                        <div class="col-md-2 d-none d-xl-block">@b.Kind</div>
                    </summary>
                </details>
                index++;
            }
        }
    </div>
</div>
