@page "/teacher"
@using Bookong.Application.DTOs
@using Bookong.Domain.Entities
@using Bookong.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Bookong.Domain.Interfaces.IUnitOfWork UnitOfWork
@inject Bookong.Application.Services.Interfaces.ISessionService SessionService
@inject BookongDbContext DbContext
@inject IJSRuntime JS

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-semibold mb-0">Správa maturitních knih – učitel</h1>
        <button class="btn btn-success">
            + Přidat novou knihu
        </button>
    </div>

    <!-- Filtr (vyhledávání, žánr, typ) -->
    <div class="border rounded-3 shadow-sm bg-body mb-4 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label">Vyhledávání</label>
                <input class="form-control" placeholder="Zadejte název nebo autora" @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Žánr</label>
                <select class="form-select" @bind="selectedGenre">
                    <option value="">Vše</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Typ</label>
                <select class="form-select" @bind="selectedKind">
                    <option value="">Vše</option>
                    @foreach (var k in kinds)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-12 col-lg-3 d-grid d-md-flex gap-2 justify-content-end">
                <button class="btn btn-primary" @onclick="ApplyFilters">Filtrovat</button>
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Vymazat filtr</button>
            </div>
        </div>
    </div>

    @if (teacherBooks is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Načítání knih…</span>
        </div>
    }
    else if (!displayedBooks.Any())
    {
        <p class="text-muted">Žádné knihy odpovídající filtru.</p>
    }
    else
    {
        <div class="border rounded-3 shadow-sm bg-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Název knihy</th>
                            <th>Autor</th>
                            <th>Žánr</th>
                            <th>Typ</th>
                            <th class="text-center" style="width:320px;">Akce</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in displayedBooks)
                        {
                            var isAvailable = IsBookAvailable(b);
                            <tr>
                                <td>@b.Title</td>
                                <td>@b.AuthorFullName</td>
                                <td>@b.Genre</td>
                                <td>@b.Kind</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center flex-nowrap">
                                        <button class="btn btn-outline-success btn-sm" @onclick="() => ToggleAvailableAsync(b)">
                                            @(isAvailable ? "Odebrat z dostupných" : "Přidat do dostupných")
                                        </button>
                                        <button class="btn btn-outline-primary btn-sm">Upravit</button>
                                        <button class="btn btn-outline-danger btn-sm">Odebrat</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<BookListItemDto>? teacherBooks;
    private List<BookListItemDto> displayedBooks = new();

    // track available books by their key properties (not PublicId!)
    private HashSet<string> availableBookKeys = new();

    private string searchTerm = string.Empty;
    private string selectedGenre = string.Empty;
    private string selectedKind = string.Empty;

    private List<string> genres = new();
    private List<string> kinds = new();

    protected override async Task OnInitializedAsync()
    {
        teacherBooks = new List<BookListItemDto>();

        try
        {
            var books = await UnitOfWork.Books.GetAllAsync();

            // load available books from MaturitaBooks table using DbContext directly
            await LoadAvailableAsync();

            teacherBooks = books.Select(b => new BookListItemDto
            {
                PublicId = b.PublicId,
                Title = b.Name ?? string.Empty,
                AuthorFullName = b.Author != null
                    ? string.Join(' ', new[] { b.Author.FirstName, b.Author.MiddleName, b.Author.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)))
                    : string.Empty,
                Genre = b.Genre?.Name ?? string.Empty,
                Kind = b.Kind?.Name ?? string.Empty,
                Borrowable = b.Borrowable
            }).ToList();

            // Naplnit možnosti filtrů
            genres = teacherBooks.Select(x => x.Genre).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();
            kinds = teacherBooks.Select(x => x.Kind).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();

            ApplyFilters();
        }
        catch (Exception)
        {
            // Pokud načítání selže, necháme teacherBooks null -> zobrazí se spinner
            teacherBooks = null;
            displayedBooks = new List<BookListItemDto>();
        }
    }

    private async Task LoadAvailableAsync()
    {
        availableBookKeys.Clear();

        // Load all books from MaturitaBooks table using DbContext directly
        var maturitaBooks = await DbContext.MaturitaBooks
            .AsNoTracking()
            .Include(mb => mb.Author)
            .Include(mb => mb.Genre)
            .Include(mb => mb.Kind)
            .ToListAsync();
            
        foreach (var mb in maturitaBooks)
        {
            var key = GetBookKey(mb.Name, mb.Author?.FirstName, mb.Author?.LastName, mb.Genre?.Name, mb.Kind?.Name);
            availableBookKeys.Add(key);
        }
    }

    private string GetBookKey(string? title, string? authorFirst, string? authorLast, string? genre, string? kind)
    {
        return $"{title}|{authorFirst}|{authorLast}|{genre}|{kind}".ToLowerInvariant();
    }

    private string GetBookKey(BookListItemDto book)
    {
        var authorParts = book.AuthorFullName?.Split(' ') ?? Array.Empty<string>();
        var firstName = authorParts.Length > 0 ? authorParts[0] : "";
        var lastName = authorParts.Length > 1 ? authorParts[^1] : "";
        
        return GetBookKey(book.Title, firstName, lastName, book.Genre, book.Kind);
    }

    private bool IsBookAvailable(BookListItemDto book)
    {
        return availableBookKeys.Contains(GetBookKey(book));
    }

    private void ApplyFilters()
    {
        if (teacherBooks is null)
        {
            displayedBooks = new List<BookListItemDto>();
            return;
        }

        var query = teacherBooks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var q = searchTerm.Trim().ToLowerInvariant();
            query = query.Where(b => (b.Title != null && b.Title.ToLowerInvariant().Contains(q)) ||
                                     (b.AuthorFullName != null && b.AuthorFullName.ToLowerInvariant().Contains(q)));
        }

        if (!string.IsNullOrWhiteSpace(selectedGenre))
            query = query.Where(b => b.Genre == selectedGenre);

        if (!string.IsNullOrWhiteSpace(selectedKind))
            query = query.Where(b => b.Kind == selectedKind);

        displayedBooks = query.ToList();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedGenre = string.Empty;
        selectedKind = string.Empty;
        ApplyFilters();
    }

    private async Task ToggleAvailableAsync(BookListItemDto dto)
    {
        // find book entity from Books table
        var book = await UnitOfWork.Books.GetByPublicIdAsync(dto.PublicId);
        if (book == null) return;

        // Validate that all required navigation properties are present
        if (book.Author == null || book.Genre == null || book.Kind == null || book.Period == null)
        {
            await JS.InvokeVoidAsync("alert", "Tuto knihu nelze přidat - chybí požadované údaje (autor, žánr, typ nebo období).");
            return;
        }

        // check if book exists in MaturitaBooks table - match by properties, not PublicId
        var existing = await DbContext.MaturitaBooks
            .Include(mb => mb.Author)
            .Include(mb => mb.Genre)
            .Include(mb => mb.Kind)
            .Include(mb => mb.Period)
            .Where(mb => mb.Name == book.Name 
                      && mb.Author.Id == book.Author.Id
                      && mb.Genre.Id == book.Genre.Id
                      && mb.Kind.Id == book.Kind.Id
                      && mb.Period.Id == book.Period.Id)
            .FirstOrDefaultAsync();

        if (existing != null)
        {
            // confirm removal
            var ok = await JS.InvokeAsync<bool>("confirm", "Opravdu chcete odebrat knihu z dostupných?");
            if (!ok) return;

            // Remove using DbContext directly (with tracking)
            DbContext.MaturitaBooks.Remove(existing);
            await DbContext.SaveChangesAsync();
            
            // Update tracking
            await LoadAvailableAsync();
        }
        else
        {
            // Get fresh instances of related entities to attach
            var author = await DbContext.Authors.FindAsync(book.Author.Id);
            var genre = await DbContext.Genres.FindAsync(book.Genre.Id);
            var kind = await DbContext.Kinds.FindAsync(book.Kind.Id);
            var period = await DbContext.Periods.FindAsync(book.Period.Id);

            if (author == null || genre == null || kind == null || period == null)
            {
                await JS.InvokeVoidAsync("alert", "Chyba: Související entity nebyly nalezeny.");
                return;
            }

            // Add book to MaturitaBooks table with properly tracked entities
            var maturitaBook = new MaturitaBook
            {
                Name = book.Name,
                Author = author,
                Genre = genre,
                Kind = kind,
                Period = period
            };
            
            DbContext.MaturitaBooks.Add(maturitaBook);
            await DbContext.SaveChangesAsync();
            
            // Update tracking
            await LoadAvailableAsync();
        }

        StateHasChanged();
    }
}
