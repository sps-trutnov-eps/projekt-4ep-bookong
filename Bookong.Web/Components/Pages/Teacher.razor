@page "/teacher"
@using Bookong.Application.DTOs
@using Microsoft.EntityFrameworkCore
@inject Bookong.Domain.Interfaces.IUnitOfWork UnitOfWork
@inject Bookong.Infrastructure.Data.BookongDbContext DbContext

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-semibold mb-0">Správa maturitních knih – učitel</h1>
        <button class="btn btn-success">
            + Přidat novou knihu
        </button>
    </div>

    <!-- Filtr (vyhledávání, žánr, typ) -->
    <div class="border rounded-3 shadow-sm bg-body mb-4 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label">Vyhledávání</label>
                <input class="form-control" placeholder="Zadejte název nebo autora" @bind="searchTerm" @bind:event="oninput" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Žánr</label>
                <select class="form-select" @bind="selectedGenre">
                    <option value="">Vše</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Typ</label>
                <select class="form-select" @bind="selectedKind">
                    <option value="">Vše</option>
                    @foreach (var k in kinds)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-12 col-lg-3 d-grid d-md-flex gap-2 justify-content-end">
                <button class="btn btn-primary" @onclick="ApplyFilters">Filtrovat</button>
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Vymazat filtr</button>
            </div>
        </div>
    </div>

    @if (teacherBooks is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Načítání knih…</span>
        </div>
    }
    else if (!displayedBooks.Any())
    {
        <p class="text-muted">Žádné knihy odpovídající filtru.</p>
    }
    else
    {
        <div class="border rounded-3 shadow-sm bg-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Název knihy</th>
                            <th>Autor</th>
                            <th>Žánr</th>
                            <th>Typ</th>
                            <th class="text-center" style="width:320px;">Akce</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in displayedBooks)
                        {
                            <tr>
                                <td>
                                    @b.Title
                                    @if (blueMarks.Contains(b.PublicId))
                                    {
                                        <span class="badge bg-primary ms-2">●</span>
                                    }
                                </td>
                                <td>@b.AuthorFullName</td>
                                <td>@b.Genre</td>
                                <td>@b.Kind</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center flex-nowrap">
                                        <button class="btn btn-outline-success btn-sm" @onclick="() => ToggleBlueMarkAsync(b)">
                                            @(blueMarks.Contains(b.PublicId) ? "Odebrat z třídy" : "Přidat do třídy")
                                        </button>
                                        <button class="btn btn-outline-primary btn-sm">Upravit</button>
                                        <button class="btn btn-outline-danger btn-sm">Odebrat</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<BookListItemDto>? teacherBooks;
    private List<BookListItemDto> displayedBooks = new();

    // track blue-marked books by PublicId without changing domain/DTO
    private HashSet<Guid> blueMarks = new();

    private string searchTerm = string.Empty;
    private string selectedGenre = string.Empty;
    private string selectedKind = string.Empty;

    private List<string> genres = new();
    private List<string> kinds = new();

    protected override async Task OnInitializedAsync()
    {
        teacherBooks = new List<BookListItemDto>();

        try
        {
            var books = await UnitOfWork.Books.GetAllAsync();

            // load blue marks from dbo.Books.HasBlueMark using raw SQL so we don't need to change domain models
            await LoadBlueMarksAsync();

            teacherBooks = books.Select(b => new BookListItemDto
            {
                PublicId = b.PublicId,
                Title = b.Name ?? string.Empty,
                AuthorFullName = b.Author != null
                    ? string.Join(' ', new[] { b.Author.FirstName, b.Author.MiddleName, b.Author.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)))
                    : string.Empty,
                Genre = b.Genre?.Name ?? string.Empty,
                Kind = b.Kind?.Name ?? string.Empty,
                Borrowable = b.Borrowable
            }).ToList();

            // Naplnit možnosti filtrů
            genres = teacherBooks.Select(x => x.Genre).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();
            kinds = teacherBooks.Select(x => x.Kind).Where(x => !string.IsNullOrEmpty(x)).Distinct().ToList();

            ApplyFilters();
        }
        catch (Exception)
        {
            // Pokud načítání selže, necháme teacherBooks null -> zobrazí se spinner
            teacherBooks = null;
            displayedBooks = new List<BookListItemDto>();
        }
    }

    private async Task LoadBlueMarksAsync()
    {
        blueMarks.Clear();

        var conn = DbContext.Database.GetDbConnection();
        try
        {
            if (conn.State != System.Data.ConnectionState.Open)
                await conn.OpenAsync();

            using var cmd = conn.CreateCommand();
            cmd.CommandText = "SELECT PublicId, HasBlueMark FROM dbo.Books";

            using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                if (!reader.IsDBNull(0))
                {
                    var publicId = reader.GetGuid(0);
                    var hasMark = !reader.IsDBNull(1) && reader.GetBoolean(1);
                    if (hasMark) blueMarks.Add(publicId);
                }
            }
        }
        finally
        {
            // do not close shared connection explicitly; DbContext manages it
            // but ensure it's closed if we opened it here
            if (conn.State == System.Data.ConnectionState.Open)
                await conn.CloseAsync();
        }
    }

    private void ApplyFilters()
    {
        if (teacherBooks is null)
        {
            displayedBooks = new List<BookListItemDto>();
            return;
        }

        var query = teacherBooks.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var q = searchTerm.Trim().ToLowerInvariant();
            query = query.Where(b => (b.Title != null && b.Title.ToLowerInvariant().Contains(q)) ||
                                     (b.AuthorFullName != null && b.AuthorFullName.ToLowerInvariant().Contains(q)));
        }

        if (!string.IsNullOrWhiteSpace(selectedGenre))
            query = query.Where(b => b.Genre == selectedGenre);

        if (!string.IsNullOrWhiteSpace(selectedKind))
            query = query.Where(b => b.Kind == selectedKind);

        displayedBooks = query.ToList();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        selectedGenre = string.Empty;
        selectedKind = string.Empty;
        ApplyFilters();
    }

    private async Task ToggleBlueMarkAsync(BookListItemDto dto)
    {
        // Toggle in DB
        var newValue = !blueMarks.Contains(dto.PublicId);

        var conn = DbContext.Database.GetDbConnection();
        try
        {
            if (conn.State != System.Data.ConnectionState.Open)
                await conn.OpenAsync();

            using var cmd = conn.CreateCommand();
            cmd.CommandText = "UPDATE dbo.Books SET HasBlueMark = @val WHERE PublicId = @pid";

            var p1 = cmd.CreateParameter();
            p1.ParameterName = "@val";
            p1.Value = newValue ?1 :0;
            p1.DbType = System.Data.DbType.Boolean;
            cmd.Parameters.Add(p1);

            var p2 = cmd.CreateParameter();
            p2.ParameterName = "@pid";
            p2.Value = dto.PublicId;
            p2.DbType = System.Data.DbType.Guid;
            cmd.Parameters.Add(p2);

            await cmd.ExecuteNonQueryAsync();
        }
        finally
        {
            if (conn.State == System.Data.ConnectionState.Open)
                await conn.CloseAsync();
        }

        // update local cache and UI
        if (newValue) blueMarks.Add(dto.PublicId);
        else blueMarks.Remove(dto.PublicId);

        StateHasChanged();
    }
}
