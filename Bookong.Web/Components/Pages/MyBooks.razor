@using Bookong.Web.Components.Layout
@using Bookong.Application.DTOs
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.Services.Interfaces
@using Bookong.Domain.Interfaces

@page "/mybooks"
@layout MainLayout
@inject IGetUserBookLoansQuery GetUserBookLoansQuery
@inject ICurrentUserService CurrentUserService
@inject IUnitOfWork UnitOfWork

<PageTitle>Moje knihy - BooKong</PageTitle>

<main class="container my-5 flex-grow-1 d-flex justify-content-center align-items-center">
  <div class="w-100" style="max-width: 900px;">
    <h2 class="mb-4 text-primary text-center">Moje knihy</h2>

    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Načítání...</span>
            </div>
        </div>
    }
    else if (borrowedBooks.Count == 0)
    {
        <p class="text-center text-muted">Nemáte žádné vypůjčené knihy.</p>
    }
    else
    {
        <div class="table-responsive mt-4">
            <table class="table table-striped table-bordered align-middle">
                <caption class="text-muted">Aktuálně vypůjčené knihy</caption>
                <thead class="table-primary">
                    <tr>
                        <th scope="col">Název</th>
                        <th scope="col">Autor</th>
                        <th scope="col">Století</th>
                        <th scope="col">Literatura</th>
                        <th scope="col">ISBN</th>
                        <th scope="col">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in borrowedBooks)
                    {
                        <tr>
                            <td>@loan.BookTitle</td>
                            <td>@loan.BookAuthor</td>
                            <td>@loan.BookPeriod</td>
                            <td>@loan.BookKind</td>
                            <td>@loan.BookISBN</td>
                            <td>
                                <button class="btn btn-success btn-sm me-2" @onclick="() => ReturnBook(loan)">Vrátit</button>
                                <button class="btn btn-primary btn-sm" @onclick="() => ProlongLoan(loan)">Půjčit znovu</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-info mt-3">@message</div>
    }

  </div>
</main>

@code {
    private List<BookLoanListItemDto> borrowedBooks = new();
    private bool isLoading = true;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var userPublicId = await CurrentUserService.GetCurrentUserPublicIdAsync();

        if (userPublicId != null)
        {
            var user = await UnitOfWork.Users.GetByPublicIdAsync(userPublicId.Value);
            
            if (user != null)
            {
                var allLoans = await GetUserBookLoansQuery.ExecuteAsync(user.SamAccountName);
                borrowedBooks = allLoans.Where(loan => !loan.IsReturned).ToList();
            }
        }

        isLoading = false;
    }

    private async Task ReturnBook(BookLoanListItemDto loan)
    {
        borrowedBooks.Remove(loan);
        message = "Kniha byla úspěšně vrácena.";
        StateHasChanged();
    }

    private async Task ProlongLoan(BookLoanListItemDto loan)
    {
        message = "Žádost o opětovné vypůjčení byla odeslána.";
        StateHasChanged();
    }
}
