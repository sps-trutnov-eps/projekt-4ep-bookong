@using Bookong.Web.Components.Layout

@page "/managementstudents"
@layout MainLayout

<PageTitle>Správa seznamů knih - BooKong</PageTitle>

<!-- Main: Management -->
<main class="container my-5 flex-grow-1 d-flex justify-content-center align-items-start">
  <div class="w-100" style="max-width: 900px;">
    <h2 class="mb-4 text-primary text-center">Správa seznamů knih pro události</h2>

    <!-- Form for creating new list -->
    <form id="create-list-form" class="mb-4" role="form" aria-label="Vytvoření nového seznamu">
      <div class="row g-2">
        <div class="col-md-4">
          <input type="text" class="form-control" placeholder="Název seznamu" aria-label="Název seznamu" required />
        </div>

        <div class="col-md-4">
          <select class="form-select" aria-label="Typ události">
            <option value="maturity" selected>Maturitní zkouška</option>
            <option value="other">Jiná událost</option>
          </select>
        </div>

        <div class="col-md-2 d-grid">
          <button type="submit" class="btn btn-primary">Vytvořit seznam</button>
        </div>
      </div>
    </form>

    <!-- Existing lists -->
    <section id="lists" aria-live="polite">
      <h3>Existující seznamy</h3>
      <p class="text-muted">Zde se zobrazí seznamy po vytvoření.</p>
      <!-- Sample list for demonstration -->
      <ul class="list-group">
        <li class="list-group-item d-flex justify-content-between align-items-center">
          Maturita 2023
          <span class="badge bg-primary rounded-pill">5 knih</span>
          <button class="btn btn-danger btn-sm" aria-label="Smazat seznam">Smazat</button>
        </li>
      </ul>
    </section>
  </div>
</main>
