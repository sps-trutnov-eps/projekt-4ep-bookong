@using Bookong.Web.Components.Layout

@page "/management-students"
@layout MainLayout

<PageTitle>Vypůjčení knížky - BooKong</PageTitle>

<!-- Main: Buttons -->
<main class="container my-5 flex-grow-1 d-flex justify-content-center align-items-start">
  <div class="w-100" style="max-width: 900px;">
    <h2 class="mb-4 text-primary text-center">Vypůjčení knížky</h2>

    <!-- Search form -->
    <form id="search-form" class="mb-4" role="search" aria-label="Vyhledávání knih">
      <div class="row g-2">
        <div class="col-md-4">
          <select class="form-select" name="field" aria-label="Vyberte pole pro vyhledávání">
            <option value="title" selected>Podle názvu</option>
            <option value="author">Podle autora</option>
            <option value="isbn">Podle ISBN</option>
            <option value="literature">Podle literatury</option>
            <option value="century">Podle století</option>
          </select>
        </div>

        <div class="col-md-6">
          <input type="search" name="query" class="form-control" placeholder="Zadejte hledaný výraz" aria-label="Hledaný výraz" required />
        </div>

        <div class="col-md-2 d-grid">
          <button type="submit" class="btn btn-primary">Hledat</button>
        </div>
      </div>
    </form>
      <!-- Results -->
    <section id="search-results" aria-live="polite">
      <p class="text-muted">Sem se zobrazí výsledky po provedení vyhledávání.</p>
    </section>
  </div>
</main>
