@page "/books"
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.UseCases.Interfaces
@using Bookong.Application.DTOs
@inject IGetAvailableBooksQuery GetAvailableBooks
@inject IGetMaturitaBooksQuery GetAvailableMaturitaBooksQuery
@inject ISelectMaturitaBookUseCase SelectMaturitaBook
@inject NavigationManager NavigationManager
@inject ILogger<Books> Logger

<div class="container my-4">
    <h1 class="fw-bold text-primary mb-3 page-hero-title">Seznam knih</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Filter -->
    <div class="border rounded-3 shadow-sm bg-body mb-4 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-4">
                <label class="form-label">Vyhledávání</label>
                <input class="form-control" placeholder="Zadejte název nebo autora"
                       @bind="tempSearchText" />
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Autor</label>
                <select class="form-select" @bind="tempSelectedAuthor">
                    <option value="">Všichni</option>
                    @foreach (var a in authors)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Žánr</label>
                <select class="form-select" @bind="tempSelectedGenre">
                    <option value="">Vše</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Typ</label>
                <select class="form-select" @bind="tempSelectedType">
                    <option value="">Vše</option>
                    @foreach (var t in types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3 col-lg-2 d-grid d-md-flex gap-2">
                <button class="btn btn-primary" @onclick="ApplyFilters">Filtrovat</button>
                <button class="btn btn-outline-secondary" @onclick="ResetFilters">Vymazat filtr</button>
            </div>
        </div>
    </div>

    <!-- Books table -->
    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Načítání...</span>
            </div>
        </div>
    }
    else if (filteredItems == null || !filteredItems.Any())
    {
        <div class="text-center">
            <p class="text-muted mb-3">Žádné knihy k zobrazení.</p>
        </div>
    }
    else
    {
        <div class="border rounded-3 shadow-sm bg-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:4%">#</th>
                            <th>Název knihy</th>
                            <th class="d-none d-md-table-cell">Autor</th>
                            <th class="d-none d-lg-table-cell">Žánr</th>
                            <th class="d-none d-xl-table-cell">Typ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < filteredItems.Count; i++)
                        {
                            var book = filteredItems[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td class="fw-medium">@book.Title</td>
                                <td class="d-none d-md-table-cell">@book.AuthorFullName</td>
                                <td class="d-none d-lg-table-cell">@book.Genre</td>
                                <td class="d-none d-xl-table-cell">@book.Kind</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<BookListItemDto>? items;
    private List<BookListItemDto> filteredItems = new();
    private bool isLoading = true;
    private string? errorMessage;

    // Temporary filter inputs
    private string tempSearchText = "";
    private string? tempSelectedAuthor;
    private string? tempSelectedGenre;
    private string? tempSelectedType;

    // Applied filters
    private string searchText = "";
    private string? selectedAuthor;
    private string? selectedGenre;
    private string? selectedType;

    private List<string> authors = new();
    private List<string> genres = new();
    private List<string> types = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            Logger.LogInformation("Loading books...");
            items = (await GetAvailableBooks.ExecuteAsync()).ToList();

            authors = items
                .Where(b => !string.IsNullOrWhiteSpace(b.AuthorFullName))
                .Select(b => b.AuthorFullName!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(a => a)
                .ToList();

            genres = items
                .Where(b => !string.IsNullOrWhiteSpace(b.Genre))
                .Select(b => b.Genre!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(g => g)
                .ToList();

            types = items
                .Where(b => !string.IsNullOrWhiteSpace(b.Kind))
                .Select(b => b.Kind!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading books");
            errorMessage = "Nepodařilo se načíst seznam knih.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        searchText = tempSearchText;
        selectedAuthor = tempSelectedAuthor;
        selectedGenre = tempSelectedGenre;
        selectedType = tempSelectedType;

        if (items == null)
        {
            filteredItems = new();
            return;
        }

        var q = items.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim().ToLower();
            q = q.Where(b =>
                (!string.IsNullOrWhiteSpace(b.Title) && b.Title.ToLower().Contains(s)) ||
                (!string.IsNullOrWhiteSpace(b.AuthorFullName) && b.AuthorFullName.ToLower().Contains(s)) ||
                (!string.IsNullOrWhiteSpace(b.Genre) && b.Genre.ToLower().Contains(s)) ||
                (!string.IsNullOrWhiteSpace(b.Kind) && b.Kind.ToLower().Contains(s))
            );
        }

        if (!string.IsNullOrWhiteSpace(selectedAuthor))
            q = q.Where(b => string.Equals(b.AuthorFullName, selectedAuthor, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(selectedGenre))
            q = q.Where(b => string.Equals(b.Genre, selectedGenre, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(selectedType))
            q = q.Where(b => string.Equals(b.Kind, selectedType, StringComparison.OrdinalIgnoreCase));

        filteredItems = q.ToList();
        StateHasChanged();
    }

    private void ResetFilters()
    {
        tempSearchText = "";
        tempSelectedAuthor = null;
        tempSelectedGenre = null;
        tempSelectedType = null;

        searchText = "";
        selectedAuthor = null;
        selectedGenre = null;
        selectedType = null;

        ApplyFilters();
    }
}
