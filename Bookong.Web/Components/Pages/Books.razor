@page "/books"
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.DTOs
@inject IGetAvailableBooksQuery GetAvailableBooks

<div class="container my-4">
    <h1 class="display-6 fw-semibold mb-4">Seznam knih</h1>

    <!-- Placeholder filtry (zatím nefunkční) -->
    <div class="border rounded-3 shadow-sm bg-body mb-4 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-4">
                <label class="form-label">Vyhledávání</label>
                <input class="form-control" placeholder="Zadejte název nebo autora" disabled />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Autor</label>
                <select class="form-select" disabled>
                    <option>Všichni</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Žánr</label>
                <select class="form-select" disabled>
                    <option>Vše</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Typ</label>
                <select class="form-select" disabled>
                    <option>Vše</option>
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2 d-grid d-md-flex gap-2">
                <button class="btn btn-primary" disabled>Filtrovat</button>
                <button class="btn btn-outline-secondary" disabled>Vymazat filtr</button>
            </div>
        </div>
        <div class="mt-2">
            <small class="text-muted">Poznámka: vyhledávání a filtry jsou zatím nefunkční.</small>
        </div>
    </div>

    @if (items is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Načítání…</span>
        </div>
    }
    else if (items.Count == 0)
    {
        <p class="text-muted">Žádné knihy k zobrazení.</p>
    }
    else
    {
        <div class="border rounded-3 shadow-sm bg-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Název knihy</th>
                            <th>Autor</th>
                            <th>Žánr</th>
                            <th>Typ</th>
                            <th class="text-end">Akce</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in items)
                        {
                            <tr>
                                <td class="fw-medium">@b.Title</td>
                                <td>@b.AuthorFullName</td>
                                <td><span>@b.Genre</span></td>
                                <td><span>@b.Kind</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="@($"/books/{b.PublicId}")">Detail</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<BookListItemDto>? items;

    protected override async Task OnInitializedAsync()
    {
        items = (await GetAvailableBooks.ExecuteAsync()).ToList();
    }
}
