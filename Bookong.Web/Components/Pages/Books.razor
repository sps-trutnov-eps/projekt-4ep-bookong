@page "/books"
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.UseCases.Commands.Interfaces
@using Bookong.Application.DTOs
@inject IGetAvailableBooksQuery GetAvailableBooks
@inject IAddBookToMaturitaSelectionCommand AddToMaturitaSelection
@inject NavigationManager NavigationManager
@inject ILogger<Books> Logger

<div class="container my-4">
    <h1 class="display-6 fw-semibold mb-4">Seznam knih</h1>

    <!-- Filtr -->
    <div class="row mb-3">
        <div class="col-12 col-md-11 col-lg-9">
            <div class="d-flex align-items-center gap-2">
                <input class="form-control rounded-pill ps-4 flex-grow-1"
                       style="height: 3rem; border-color: #0a4db8; max-width: 600px;"
                       placeholder="Hledejte knihy podle názvu..."
                       @bind="searchText" @bind:event="oninput" />

                <select class="form-select rounded-pill ms-2"
                        style="height: 3rem; min-width: 180px; border-color: #0a4db8;"
                        @bind="selectedAuthor" @bind:event="onchange">
                    <option value="">Autor</option>
                    @foreach (var a in authors)
                    {
                        <option value="@a">@a</option>
                    }
                </select>


                <select class="form-select rounded-pill ms-2"
                        style="height: 3rem; min-width: 160px; border-color: #0a4db8;"
                        @bind="selectedType" @bind:event="onchange">
                    <option value="">Typ</option>
                    @foreach (var t in types)
                    {
                        <option value="@t">@t</option>
                    }
                </select>

                <button class="btn btn-outline-secondary rounded-pill ms-2" style="height: 3rem;" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>

    @if (items is null)
    {
        <div class="d-flex align-items-center gap-2 text-muted">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Načítání…</span>
        </div>
    }
    else if (filteredItems == null || filteredItems.Count == 0)
    {
        <p class="text-muted">Žádné knihy k zobrazení.</p>
    }
    else
    {
        <div class="border rounded-3 shadow-sm bg-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Název knihy</th>
                            <th>Autor</th>
                            <th>Žánr</th>
                            <th>Typ</th>
                            <th class="text-end">Akce</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in filteredItems)
                        {
                            var bookId = book.PublicId;
                            <tr>
                                <td class="fw-medium">@book.Title</td>
                                <td>@book.AuthorFullName</td>
                                <td><span>@book.Genre</span></td>
                                <td><span>@book.Kind</span></td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-sm btn-outline-primary" href="@($"/books/{book.PublicId}")">Detail</a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-success"
                                                @onclick="() => OnAddToSelection(bookId)"
                                                disabled="@(isProcessing)">
                                            @if (isProcessing && processingBookId == bookId)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                                <span class="ms-1">Přidávám...</span>
                                            }
                                            else
                                            {
                                                <span>Přidat do seznamu</span>
                                            }
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<BookListItemDto>? items;
    private List<BookListItemDto> filteredItems = new();
    private bool isProcessing;
    private Guid processingBookId;

    // filters
    private string _searchText = "";
    private string searchText
    {
        get => _searchText;
        set
        {
            if (_searchText == value) return;
            _searchText = value;
            ApplyFilters();
        }
    }

    private List<string> authors = new();
    private List<string> types = new();

    private string? _selectedAuthor;
    private string? selectedAuthor
    {
        get => _selectedAuthor;
        set
        {
            if (_selectedAuthor == value) return;
            _selectedAuthor = value;
            ApplyFilters();
        }
    }

    private string? _selectedType;
    private string? selectedType
    {
        get => _selectedType;
        set
        {
            if (_selectedType == value) return;
            _selectedType = value;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("Loading books...");
            items = (await GetAvailableBooks.ExecuteAsync()).ToList();

            // derive authors and types from available books (only actual values)
            authors = items
                .Where(b => !string.IsNullOrWhiteSpace(b.AuthorFullName))
                .Select(b => b.AuthorFullName!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(a => a)
                .ToList();

            types = items
                .Where(b => !string.IsNullOrWhiteSpace(b.Kind))
                .Select(b => b.Kind!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(t => t)
                .ToList();

            Logger.LogInformation($"Loaded {items.Count} books");
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading books");
        }
    }

    private async Task OnAddToSelection(Guid bookId)
    {
        if (isProcessing) return;

        try
        {
            Logger.LogInformation($"Starting to add book {bookId} to selection");
            isProcessing = true;
            processingBookId = bookId;
            StateHasChanged();

            await AddToMaturitaSelection.ExecuteAsync(bookId);
            Logger.LogInformation($"Book {bookId} added to selection successfully");

            NavigationManager.NavigateTo("/maturita", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Error adding book {bookId} to selection");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void ResetFilters()
    {
        searchText = "";
        selectedAuthor = null;
        selectedType = null;
        ApplyFilters();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        if (items == null)
        {
            filteredItems = new();
            return;
        }

        var q = items.AsEnumerable();

        // search by title containing the text anywhere (not just at start)
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim().ToLower();
            q = q.Where(b => 
                (!string.IsNullOrWhiteSpace(b.Title) && b.Title.ToLower().Contains(s)) ||
                (!string.IsNullOrWhiteSpace(b.AuthorFullName) && b.AuthorFullName.ToLower().Contains(s)) ||
                (!string.IsNullOrWhiteSpace(b.Genre) && b.Genre.ToLower().Contains(s)) ||
                (!string.IsNullOrWhiteSpace(b.Kind) && b.Kind.ToLower().Contains(s))
            );
        }

        if (!string.IsNullOrWhiteSpace(selectedAuthor))
            q = q.Where(b => string.Equals(b.AuthorFullName, selectedAuthor, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(selectedType))
            q = q.Where(b => string.Equals(b.Kind, selectedType, StringComparison.OrdinalIgnoreCase));

        filteredItems = q.ToList();
    }
}
