@page "/materials"
@using Bookong.Web.Services
@using Bookong.Web.Models
@using System.ComponentModel.DataAnnotations
@inject ITeachingMaterialsApi TeachingMaterialsApi

<div class="materials-hero container py-5 mb-4">
    <h1 class="materials-title mb-3">Výukové materiály <span class="badge bg-white text-dark ms-2 shadow-sm">@((folders?.Count) ?? 0)</span></h1>
    <p class="materials-subtitle mb-4">Rychle najděte a spravujte studijní předměty – moderní, čisté a responzivní rozhraní.</p>
    <EditForm Model="formModel" OnValidSubmit="HandleFormSubmit">
        <DataAnnotationsValidator />
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <InputText class="form-control" @bind-Value="formModel.Name" placeholder="Název předmětu" />
                <ValidationMessage For="@(() => formModel.Name)" class="text-danger small" />
            </div>
            <div class="col-md-2">
                <InputText class="form-control" @bind-Value="formModel.Field" placeholder="Název oboru" />
                <ValidationMessage For="@(() => formModel.Field)" class="text-danger small" />
            </div>
            <div class="col-md-2">
                <InputText class="form-control" @bind-Value="formModel.CreatedBy" placeholder="Vaše jméno" />
                <ValidationMessage For="@(() => formModel.CreatedBy)" class="text-danger small" />
            </div>
            <div class="col-md-3">
                <InputTextArea class="form-control" @bind-Value="formModel.Description" placeholder="Krátký popis" rows="1" />
                <ValidationMessage For="@(() => formModel.Description)" class="text-danger small" />
            </div>
            <div class="col-md-2">
                <InputText class="form-control" @bind-Value="formModel.LinkUrl" placeholder="https://..." />
                <ValidationMessage For="@(() => formModel.LinkUrl)" class="text-danger small" />
            </div>
            <div class="col-12 mt-2">
                <button class="btn btn-gradient w-100" type="submit">
                    @(editingFolder != null ? "Uložit změny" : "Vytvořit předmět")
                </button>
                @if (editingFolder != null)
                {
                    <button type="button" class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelEdit">Zrušit</button>
                }
            </div>
        </div>
    </EditForm>
</div>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <h4 class="mb-4 text-center">Vytvořené předměty</h4>
            @if (folders == null || folders.Count == 0)
            {
                <div class="empty-state card p-4 text-center border-0 shadow-sm">
                    <div class="empty-emoji mb-2">📚</div>
                    <div class="fw-semibold">Zatím žádné předměty</div>
                    <div class="text-muted small">Vytvořte první předmět pomocí lišty nahoře.</div>
                </div>
            }
            else
            {
                <!-- GRID layout – na větších monitorech 2 až 3 sloupce  -->
                <div class="row g-4">
                    @foreach (var f in folders)
                    {
                        var collapseId = $"collapse_{f.Name.GetHashCode()}";
                        <div class="col-md-6 col-lg-4">
                            <!-- Dvě/3 karty vedle sebe -->
                            <div class="accordion" id="@($"accordion_{collapseId}")">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="@($"heading_{collapseId}")">
                                        <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="@($"#{collapseId}")"
                                                aria-expanded="false" aria-controls="@collapseId">
                                            <b>@f.Name</b> | <span class="small text-muted">@f.Field</span>
                                        </button>
                                    </h2>
                                    <div class="accordion-collapse collapse"
                                         id="@collapseId"
                                         aria-labelledby="@($"heading_{collapseId}")"
                                         data-bs-parent="@($"accordion_{collapseId}")">
                                        <div class="accordion-body">
                                            <p><b>Autor:</b> @f.CreatedBy</p>
                                            <p><b>Popis:</b> @f.Description</p>
                                            <p><b>Odkaz:</b> <a href="@f.LinkUrl" target="_blank">@f.LinkUrl</a></p>
                                            <p class="mt-2 text-muted small">Vytvořeno: @f.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
                                            @if (f.StudentMaterials != null && f.StudentMaterials.Count > 0)
                                            {
                                                <hr />
                                                <h6>Poznámky / Materiály:</h6>
                                                <ul>
                                                    @foreach (var note in f.StudentMaterials)
                                                    {
                                                        <li><b>@note.Title</b>: @note.Description</li>
                                                    }
                                                </ul>
                                            }
                                            <div class="d-flex gap-2 mt-3">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(f)">Upravit</button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFolder(f)">Smazat</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FolderDto> folders = new();
    private FormFolderModel formModel = new();
    private FolderDto editingFolder = null;

    public class FormFolderModel
    {
        [Required(ErrorMessage = "Název předmětu je povinný.")]
        public string? Name { get; set; }
        [Required(ErrorMessage = "Obor je povinný.")]
        public string? Field { get; set; }
        [Required(ErrorMessage = "Autor je povinný.")]
        public string? CreatedBy { get; set; }
        [Required(ErrorMessage = "Popis je povinný.")]
        public string? Description { get; set; }
        [Required(ErrorMessage = "URL odkaz je povinný.")]
        public string? LinkUrl { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync() ?? new();
    }

    private async Task HandleFormSubmit()
    {
        if (editingFolder != null)
        {
            editingFolder.Name = formModel.Name ?? "";
            editingFolder.Field = formModel.Field ?? "";
            editingFolder.Description = formModel.Description ?? "";
            editingFolder.CreatedBy = formModel.CreatedBy ?? "";
            editingFolder.LinkUrl = formModel.LinkUrl ?? "";
            editingFolder.CreatedAt = DateTime.Now;
            await TeachingMaterialsApi.UpdateFolderAsync(editingFolder);
            editingFolder = null;
        }
        else
        {
            var folder = new FolderDto
            {
                Name = formModel.Name ?? "",
                Field = formModel.Field ?? "",
                Description = formModel.Description ?? "",
                CreatedBy = formModel.CreatedBy ?? "",
                LinkUrl = formModel.LinkUrl ?? "",
                Files = new List<FileDto>(),
                Links = new List<LinkDto>(),
                StudentMaterials = new List<StudentMaterialDto>(),
                CreatedAt = DateTime.Now
            };
            await TeachingMaterialsApi.CreateFolderAsync(folder);
        }
        folders = await TeachingMaterialsApi.GetFoldersAsync() ?? new();
        formModel = new FormFolderModel();
    }

    private void StartEdit(FolderDto folder)
    {
        editingFolder = folder;
        formModel = new FormFolderModel
        {
            Name = folder.Name,
            Field = folder.Field,
            Description = folder.Description,
            CreatedBy = folder.CreatedBy,
            LinkUrl = folder.LinkUrl
        };
    }

    private void CancelEdit()
    {
        editingFolder = null;
        formModel = new FormFolderModel();
    }

    private async Task DeleteFolder(FolderDto folder)
    {
        await TeachingMaterialsApi.DeleteFolderAsync(folder);
        folders = await TeachingMaterialsApi.GetFoldersAsync() ?? new();
    }
}
