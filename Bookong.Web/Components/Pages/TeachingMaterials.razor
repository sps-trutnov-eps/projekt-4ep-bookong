@page "/materials"
@using Bookong.Web.Services
@using Bookong.Web.Models
@inject TeachingMaterialsApi TeachingMaterialsApi

<h1>Výukové materiály</h1>
<div class="container">
    <div class="row">
        <!-- Navigation -->
        <div class="col-4">
            <ul class="list-group">
                @if (folders != null)
                {
                    foreach (var folder in folders)
                    {
                        <li class="list-group-item @(selectedFolder == folder ? "active" : "")"
                            @onclick="@(() => SelectFolder(folder))">
                            @folder.Name
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item">Načítám složky...</li>
                }
            </ul>
        </div>
        <!-- Detail selected folder -->
        <div class="col-8">
            @if (selectedFolder != null)
            {
                <h2>@selectedFolder.Name</h2>
                <p>@selectedFolder.Description</p>
                <p><strong>Založil:</strong> @selectedFolder.CreatedBy</p>

                <h4>Soubory</h4>
                @if (selectedFolder.Files != null && selectedFolder.Files.Count > 0)
                {
                    <ul>
                        @foreach (var file in selectedFolder.Files)
                        {
                            <li>@file.FileName (@file.FileType)</li>
                        }
                    </ul>
                }
                else
                {
                    <p>Žádné soubory.</p>
                }

                <h4>Odkazy</h4>
                @if (selectedFolder.Links != null && selectedFolder.Links.Count > 0)
                {
                    <ul>
                        @foreach (var link in selectedFolder.Links)
                        {
                            <li><a href="@link.Url" target="_blank">@link.Name</a></li>
                        }
                    </ul>
                }
                else
                {
                    <p>Žádné odkazy.</p>
                }

                <h4>Materiály pro žáky</h4>
                @if (selectedFolder.StudentMaterials != null && selectedFolder.StudentMaterials.Count > 0)
                {
                    <ul>
                        @foreach (var material in selectedFolder.StudentMaterials)
                        {
                            <li>@material.Title – @material.Description</li>
                        }
                    </ul>
                }
                else
                {
                    <p>Žádné materiály pro žáky.</p>
                }
            }
            else
            {
                <p>Vyberte složku pro zobrazení detailů.</p>
            }
        </div>
    </div>
</div>

@code {
    private List<FolderDto> folders;
    private FolderDto selectedFolder;

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private void SelectFolder(FolderDto folder)
    {
        selectedFolder = folder;
    }
}
