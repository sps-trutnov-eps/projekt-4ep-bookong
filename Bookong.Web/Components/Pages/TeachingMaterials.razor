@page "/materials"
@using Bookong.Web.Services
@using Bookong.Web.Models
@using System.ComponentModel.DataAnnotations
@inject ITeachingMaterialsApi TeachingMaterialsApi

<h1>Výukové materiály</h1>

<div class="container">
    <div class="row">
        <div class="col-6">
            <EditForm Model="newFolder" OnValidSubmit="CreateFolder" FormName="CreateMaterialForm">
                <DataAnnotationsValidator />
                <div class="mb-2">
                    <InputText class="form-control" @bind-Value="newFolder.Name" placeholder="Název předmětu" />
                </div>
                <div class="mb-2">
                    <InputText class="form-control" @bind-Value="newFolder.Description" placeholder="Popis" />
                </div>
                <div class="mb-2">
                    <InputText class="form-control" @bind-Value="newFolder.CreatedBy" placeholder="Založil (vaše jméno)" />
                </div>
                <button type="submit" class="btn btn-primary mb-3">Vytvořit předmět</button>
                <ValidationSummary />
            </EditForm>
        </div>

        <div class="col-6">
            <h4>Vytvořené předměty</h4>

            @if (folders == null)
            {
                <p>Načítám...</p>
            }
            else if (folders.Count == 0)
            {
                <p>Ještě nejsou vytvořené žádné předměty.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var f in folders)
                    {
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">@f.Name</h5>
                                <small>@f.CreatedBy</small>
                            </div>
                            <p class="mb-1">@f.Description</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FolderDto>? folders;
    private CreateFolderModel newFolder = new CreateFolderModel();

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private async Task CreateFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolder.Name))
            return;

        var folder = new FolderDto
        {
            Name = newFolder.Name,
            Description = newFolder.Description ?? string.Empty,
            CreatedBy = string.IsNullOrWhiteSpace(newFolder.CreatedBy) ? "Neznámý" : newFolder.CreatedBy,
            Files = new List<FileDto>(),
            Links = new List<LinkDto>(),
            StudentMaterials = new List<StudentMaterialDto>()
        };

        await TeachingMaterialsApi.CreateFolderAsync(folder);
        folders = await TeachingMaterialsApi.GetFoldersAsync();
        newFolder = new CreateFolderModel();
    }

    private class CreateFolderModel
    {
        [Required(ErrorMessage = "Zadejte název předmětu.")]
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? CreatedBy { get; set; }
    }
}
