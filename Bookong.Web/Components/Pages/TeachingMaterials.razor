@page "/materials"
@using Bookong.Web.Services
@using Bookong.Web.Models
@using System.ComponentModel.DataAnnotations
@inject ITeachingMaterialsApi TeachingMaterialsApi

<div class="materials-hero container py-5 mb-4">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="materials-title mb-1">Výukové materiály</h1>
            <p class="materials-subtitle mb-0">Povinně vyplňte předmět, obor, autora, popis a odkaz. Datum se doplní automaticky.</p>
        </div>
        <div>
            <button class="btn btn-outline-light btn-sm" @onclick="() => { newFolder = new(); editingFolder = null; }">Nový předmět</button>
        </div>
    </div>
</div>

<div class="container">
    <div class="row gy-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 p-3 mb-3">
                <h4 class="mb-3">
                    @if (editingFolder != null)
                    {
                        <span>Upravit předmět</span>
                    }
                    else
                    {
                        <span>Vytvořit předmět</span>
                    }
                </h4>

                <EditForm Model="newFolder" OnValidSubmit="HandleFormSubmit" FormName="CreateMaterialForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label small">Předmět</label>
                        <InputText class="form-control form-control-lg rounded-pill shadow-sm" @bind-Value="newFolder.Name" placeholder="Název předmětu" />
                        <ValidationMessage For="@(() => newFolder.Name)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Obor</label>
                        <InputText class="form-control rounded-pill shadow-sm" @bind-Value="newFolder.Field" placeholder="Název oboru" />
                        <ValidationMessage For="@(() => newFolder.Field)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Autor</label>
                        <InputText class="form-control rounded-pill shadow-sm" @bind-Value="newFolder.CreatedBy" placeholder="Vaše jméno" />
                        <ValidationMessage For="@(() => newFolder.CreatedBy)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Popis</label>
                        <InputTextArea class="form-control" @bind-Value="newFolder.Description" placeholder="Krátký popis" rows="4" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">URL odkaz</label>
                        <InputText class="form-control rounded-pill shadow-sm" @bind-Value="newFolder.LinkUrl" placeholder="https://..." />
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg rounded-pill" type="submit" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                @(editingFolder != null ? "Ukládám..." : "Vytvářím...")
                            }
                            else
                            {
                                @(editingFolder != null ? "Uložit změny" : "Vytvořit předmět")
                            }
                        </button>
                    </div>

                    @if (editingFolder != null)
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-secondary w-100" @onclick="CancelEdit">Zrušit</button>
                        </div>
                    }

                    <ValidationSummary class="mt-2 text-danger" />
                </EditForm>
            </div>
        </div>

        <div class="col-lg-7">
            <h4 class="mb-3">Vytvořené předměty</h4>

            @if (folders == null)
            {
                <div class="d-flex align-items-center">
                    <div class="spinner-border text-primary me-3" role="status"><span class="visually-hidden">Načítám...</span></div>
                    <div>Načítání předmětů…</div>
                </div>
            }
            else if (folders.Count == 0)
            {
                <div class="empty-state card p-4 text-center border-0 shadow-sm">
                    <div class="empty-emoji mb-2">📚</div>
                    <div class="fw-semibold">Zatím žádné předměty</div>
                    <div class="text-muted small">Vytvořte první předmět pomocí formuláře vlevo.</div>
                </div>
            }
            else
            {
                <div class="row g-3 created-list">
                    @foreach (var f in folders)
                    {
                        <div class="col-sm-6">
                            <div class="card created-card h-100 shadow-sm border-0">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="card-title mb-1">@f.Name</h5>
                                        <small class="text-muted">@f.CreatedBy</small>
                                    </div>
                                    <p class="card-text small mb-1"><b>Obor:</b> @f.Field</p>
                                    <p class="card-text small text-muted mb-1 text-truncate">@f.Description</p>
                                    <p class="mb-2">
                                        <a href="@f.LinkUrl" target="_blank" class="text-decoration-none text-primary small">@f.LinkUrl</a><br />
                                        <span class="text-muted small">Vytvořeno: @f.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                    </p>
                                    <div class="mt-3 d-flex">
                                        <button class="btn btn-outline-primary btn-sm me-2 flex-grow-1" @onclick="() => StartEdit(f)">Upravit</button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteFolder(f)">Smazat</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FolderDto>? folders;
    private FolderDto newFolder = new();
    private FolderDto? editingFolder = null;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private async Task HandleFormSubmit()
    {
        if (isSaving) return;
        isSaving = true;
        try
        {
            if (editingFolder != null)
            {
                editingFolder.Name = newFolder.Name ?? string.Empty;
                editingFolder.Field = newFolder.Field ?? string.Empty;
                editingFolder.Description = newFolder.Description ?? string.Empty;
                editingFolder.CreatedBy = string.IsNullOrWhiteSpace(newFolder.CreatedBy) ? "Neznámý" : newFolder.CreatedBy;
                editingFolder.LinkUrl = newFolder.LinkUrl ?? string.Empty;
                editingFolder.CreatedAt = DateTime.Now;
                await TeachingMaterialsApi.UpdateFolderAsync(editingFolder);
                editingFolder = null;
            }
            else
            {
                var folder = new FolderDto
                {
                    Name = newFolder.Name ?? string.Empty,
                    Field = newFolder.Field ?? string.Empty,
                    Description = newFolder.Description ?? string.Empty,
                    CreatedBy = string.IsNullOrWhiteSpace(newFolder.CreatedBy) ? "Neznámý" : newFolder.CreatedBy,
                    LinkUrl = newFolder.LinkUrl ?? string.Empty,
                    Files = new List<FileDto>(),
                    Links = new List<LinkDto>(),
                    StudentMaterials = new List<StudentMaterialDto>(),
                    CreatedAt = DateTime.Now
                };
                await TeachingMaterialsApi.CreateFolderAsync(folder);
            }

            folders = await TeachingMaterialsApi.GetFoldersAsync();
            newFolder = new();
        }
        catch
        {
            // Můžete zde přidat notifikaci erroru
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEdit(FolderDto folder)
    {
        editingFolder = folder;
        newFolder = new FolderDto
        {
            Name = folder.Name,
            Field = folder.Field,
            Description = folder.Description,
            CreatedBy = folder.CreatedBy,
            LinkUrl = folder.LinkUrl
        };
    }

    private void CancelEdit()
    {
        editingFolder = null;
        newFolder = new FolderDto();
    }

    private async Task DeleteFolder(FolderDto folder)
    {
        await TeachingMaterialsApi.DeleteFolderAsync(folder);
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }
}
