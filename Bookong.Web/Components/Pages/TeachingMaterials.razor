@page "/materials"
@using Bookong.Web.Services
@using Bookong.Web.Models
@using System.ComponentModel.DataAnnotations
@inject ITeachingMaterialsApi TeachingMaterialsApi

<div class="materials-hero container py-5 mb-4">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="materials-title mb-1">Výukové materiály</h1>
            <p class="materials-subtitle mb-0">Rychle najděte a spravujte studijní předměty — moderní, čisté a responzivní rozhraní.</p>
        </div>
        <div class="d-none d-md-block">
            <button class="btn btn-outline-light btn-sm" @onclick="() => { newFolder = new(); editingFolder = null; }">Nový předmět</button>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <div class="flex-grow-1">
            <div class="input-group shadow-sm search-glass">
                <span class="input-group-text bg-transparent border-0">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 21l-4.35-4.35"></path><circle cx="11" cy="11" r="6"></circle></svg>
                </span>
                <input class="form-control form-control-lg border-0" placeholder="Hledat předmět nebo obor..." @bind="searchTerm" />
            </div>
        </div>
        <div>
            <button class="btn btn-light btn-lg shadow-sm" @onclick="ToggleView">@((compactView) ? "Rozšířený" : "Kompaktní")</button>
        </div>
    </div>
</div>

<div class="container">
    <div class="row gy-4">
        <div class="col-lg-5">
            <div class="card form-card shadow border-0 p-3 mb-3">
                <h5 class="mb-3">
                    @if (editingFolder != null)
                    {
                        <span class="muted">Upravit předmět</span>
                    }
                    else
                    {
                        <span class="muted">Vytvořit předmět</span>
                    }
                </h5>

                <EditForm Model="newFolder" OnValidSubmit="HandleFormSubmit" FormName="CreateMaterialForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label small">Předmět</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">📘</span>
                            <InputText class="form-control form-control-lg rounded-pill" @bind-Value="newFolder.Name" placeholder="Název předmětu" />
                        </div>
                        <ValidationMessage For="@(() => newFolder.Name)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Obor</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">🏷️</span>
                            <InputText class="form-control rounded-pill" @bind-Value="newFolder.Field" placeholder="Název oboru" />
                        </div>
                        <ValidationMessage For="@(() => newFolder.Field)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Autor</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">👤</span>
                            <InputText class="form-control rounded-pill" @bind-Value="newFolder.CreatedBy" placeholder="Vaše jméno" />
                        </div>
                        <ValidationMessage For="@(() => newFolder.CreatedBy)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Popis</label>
                        <InputTextArea class="form-control" @bind-Value="newFolder.Description" placeholder="Krátký popis" rows="4" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">URL odkaz</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">🔗</span>
                            <InputText class="form-control rounded-pill" @bind-Value="newFolder.LinkUrl" placeholder="https://..." />
                        </div>
                    </div>

                    <!-- Datum a čas se nastaví automaticky v modelu -->
                    <div class="d-grid">
                        <button class="btn btn-gradient btn-lg rounded-pill" type="submit" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                @(editingFolder != null ? "Ukládám..." : "Vytvářím...")
                            }
                            else
                            {
                                @(editingFolder != null ? "Uložit změny" : "Vytvořit předmět")
                            }
                        </button>
                    </div>

                    @if (editingFolder != null)
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-secondary w-100" @onclick="CancelEdit">Zrušit</button>
                        </div>
                    }

                    <ValidationSummary class="mt-2 text-danger" />
                </EditForm>
            </div>
        </div>

        <div class="col-lg-7">
            <h5 class="mb-3">Vytvořené předměty</h5>

            @if (folders == null)
            {
                <div class="d-flex align-items-center">
                    <div class="spinner-border text-primary me-3" role="status"><span class="visually-hidden">Načítám...</span></div>
                    <div>Načítání předmětů…</div>
                </div>
            }
            else if (FilteredFolders.Count == 0)
            {
                <div class="empty-state card p-4 text-center border-0 shadow-sm">
                    <div class="empty-emoji mb-2">📚</div>
                    <div class="fw-semibold">Zatím žádné předměty</div>
                    <div class="text-muted small">Vytvořte první předmět pomocí formuláře vlevo.</div>
                </div>
            }
            else
            {
                <div class="row g-3 created-list">
                    @foreach (var f in FilteredFolders)
                    {
                        <div class="col-sm-6">
                            <div class="card created-card h-100 shadow border-0">
                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="card-title mb-1">@f.Name</h6>
                                            <div class="text-muted small">@f.Field</div>
                                        </div>
                                        <small class="text-muted">@f.CreatedBy</small>
                                    </div>

                                    <p class="card-text small text-muted mb-2 text-truncate">@f.Description</p>

                                    <div class="mt-auto d-flex justify-content-between align-items-center">
                                        <a href="@f.LinkUrl" target="_blank" class="link-primary small text-truncate d-block me-3">@f.LinkUrl</a>
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(f)" title="Upravit">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 21v-3.75L14.81 5.44l3.75 3.75L6.75 21H3z"></path></svg>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFolder(f)" title="Smazat">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 6h18"></path><path d="M8 6v12"></path><path d="M16 6v12"></path><path d="M10 6V4h4v2"></path></svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FolderDto>? folders;
    private FolderDto newFolder = new();
    private FolderDto? editingFolder = null;
    private bool isSaving = false;
    private bool compactView = false;
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private IReadOnlyList<FolderDto> FilteredFolders =>
        string.IsNullOrWhiteSpace(searchTerm) || folders == null
            ? folders ?? new List<FolderDto>()
            : folders.Where(f =>
                (f.Name ?? "").Contains(searchTerm, StringComparison.CurrentCultureIgnoreCase) ||
                (f.Field ?? "").Contains(searchTerm, StringComparison.CurrentCultureIgnoreCase) ||
                (f.CreatedBy ?? "").Contains(searchTerm, StringComparison.CurrentCultureIgnoreCase)
            ).ToList();

    private async Task HandleFormSubmit()
    {
        if (isSaving) return;
        isSaving = true;
        try
        {
            if (editingFolder != null)
            {
                editingFolder.Name = newFolder.Name ?? string.Empty;
                editingFolder.Field = newFolder.Field ?? string.Empty;
                editingFolder.Description = newFolder.Description ?? string.Empty;
                editingFolder.CreatedBy = string.IsNullOrWhiteSpace(newFolder.CreatedBy) ? "Neznámý" : newFolder.CreatedBy;
                editingFolder.LinkUrl = newFolder.LinkUrl ?? string.Empty;
                editingFolder.CreatedAt = DateTime.Now;
                await TeachingMaterialsApi.UpdateFolderAsync(editingFolder);
                editingFolder = null;
            }
            else
            {
                var folder = new FolderDto
                {
                    Name = newFolder.Name ?? string.Empty,
                    Field = newFolder.Field ?? string.Empty,
                    Description = newFolder.Description ?? string.Empty,
                    CreatedBy = string.IsNullOrWhiteSpace(newFolder.CreatedBy) ? "Neznámý" : newFolder.CreatedBy,
                    LinkUrl = newFolder.LinkUrl ?? string.Empty,
                    Files = new List<FileDto>(),
                    Links = new List<LinkDto>(),
                    StudentMaterials = new List<StudentMaterialDto>(),
                    CreatedAt = DateTime.Now
                };
                await TeachingMaterialsApi.CreateFolderAsync(folder);
            }

            folders = await TeachingMaterialsApi.GetFoldersAsync();
            newFolder = new();
            searchTerm = string.Empty;
        }
        catch
        {
            // Můžete zde přidat notifikaci erroru
        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEdit(FolderDto folder)
    {
        editingFolder = folder;
        newFolder = new FolderDto
        {
            Name = folder.Name,
            Field = folder.Field,
            Description = folder.Description,
            CreatedBy = folder.CreatedBy,
            LinkUrl = folder.LinkUrl
        };
    }

    private void CancelEdit()
    {
        editingFolder = null;
        newFolder = new FolderDto();
    }

    private async Task DeleteFolder(FolderDto folder)
    {
        await TeachingMaterialsApi.DeleteFolderAsync(folder);
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private void ToggleView()
    {
        compactView = !compactView;
        // compactView can be used later to change card layout classes
    }
}
