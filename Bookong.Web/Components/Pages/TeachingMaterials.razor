@page "/materials"
@using Bookong.Web.Services
@using Bookong.Web.Models
@using System.ComponentModel.DataAnnotations
@inject ITeachingMaterialsApi TeachingMaterialsApi

<div class="materials-hero container">
    <h1 class="materials-title">Výukové materiály</h1>
    <p class="materials-subtitle">Vytvořte předmět v rámci svého oboru a spravujte je přehledně.</p>
</div>

<div class="container">
    <div class="row gy-4">
        <div class="col-md-5">
            <div class="materials-card">
                <h4 class="mb-3">
                    @if (editingFolder != null)
                    {
                        <span>Upravit předmět</span>
                    }
                    else
                    {
                        <span>Vytvořit předmět</span>
                    }
                </h4>

                <EditForm Model="newFolder" OnValidSubmit="HandleFormSubmit" FormName="CreateMaterialForm">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label small">Obor</label>
                        <InputSelect class="form-select form-control-lg" @bind-Value="selectedMajor">
                            <option value="">-- Vyberte obor --</option>
                            @foreach (var major in majorsWithSubjects.Keys)
                            {
                                <option value="@major">@major</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Předmět</label>
                        <InputSelect class="form-select form-control-lg" @bind-Value="newFolder.Name" disabled="@string.IsNullOrWhiteSpace(selectedMajor)">
                            <option value="">-- Vyberte předmět --</option>
                            @if (!string.IsNullOrWhiteSpace(selectedMajor))
                            {
                                foreach (var s in FilteredSubjects)
                                {
                                    <option value="@s">@s</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => newFolder.Name)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Popis</label>
                        <InputText class="form-control" @bind-Value="newFolder.Description" placeholder="Krátký popis" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Založil</label>
                        <InputText class="form-control" @bind-Value="newFolder.CreatedBy" placeholder="Vaše jméno" />
                    </div>
                    <button class="btn btn-gradient w-100 btn-lg" type="submit">
                        @(editingFolder != null ? "Uložit změny" : "Vytvořit předmět")
                    </button>
                    @if (editingFolder != null)
                    {
                        <button type="button" class="btn btn-secondary w-100 mt-2" @onclick="CancelEdit">Zrušit</button>
                    }
                    <ValidationSummary class="mt-2 text-danger" />
                </EditForm>
            </div>
        </div>

        <div class="col-md-7">
            <h4 class="mb-3">Vytvořené předměty</h4>
            @if (folders == null)
            {
                <div class="d-flex align-items-center">
                    <div class="spinner-border text-primary me-3" role="status"><span class="visually-hidden">Načítám...</span></div>
                    <div>Načítání předmětů…</div>
                </div>
            }
            else if (folders.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-emoji">📚</div>
                    <div class="fw-semibold">Zatím žádné předměty</div>
                    <div class="text-muted small">Vytvořte první předmět pomocí formuláře vpravo.</div>
                </div>
            }
            else
            {
                <div class="row g-3 created-list">
                    @foreach (var f in folders.Where(f => string.IsNullOrWhiteSpace(selectedMajor) || FilteredSubjects.Contains(f.Name)))
                    {
                        <div class="col-sm-6">
                            <div class="card created-card" style="border-left:6px solid @GetAccentColor(f.Name);">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h5 class="card-title mb-1">@f.Name</h5>
                                        <small class="text-muted">@f.CreatedBy</small>
                                    </div>
                                    <p class="card-text small text-muted mb-1">@f.Description</p>
                                    <div class="mt-2">
                                        <span class="badge bg-light text-dark">@((f.Files?.Count) ?? 0) souborů</span>
                                        <span class="badge bg-light text-dark">@((f.Links?.Count) ?? 0) odkazů</span>
                                    </div>
                                    <div class="mt-3">
                                        <button class="btn btn-outline-primary btn-sm me-2" @onclick="() => StartEdit(f)">Upravit</button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteFolder(f)">Smazat</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<FolderDto>? folders;
    private CreateFolderModel newFolder = new();
    private FolderDto? editingFolder = null;
    private string? selectedMajor;

    private readonly Dictionary<string, List<string>> majorsWithSubjects = new()
    {
        // Zúžený testovací příklad
        ["Elektronické počítačové systémy"] = new()
        {
            "Matematika",
            "Dějepis",
            "Fyzika"
        },
        ["Informatika a Management"] = new()
        {
            "Angličtina",
            "Webové stránky",
            "Ekonomika"
        }
    };

    private List<string> FilteredSubjects =>
        string.IsNullOrWhiteSpace(selectedMajor) ? new() : majorsWithSubjects[selectedMajor];

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private async Task HandleFormSubmit()
    {
        if (editingFolder != null)
        {
            editingFolder.Name = newFolder.Name ?? string.Empty;
            editingFolder.Description = newFolder.Description ?? string.Empty;
            editingFolder.CreatedBy = string.IsNullOrWhiteSpace(newFolder.CreatedBy) ? "Neznámý" : newFolder.CreatedBy;
            await TeachingMaterialsApi.UpdateFolderAsync(editingFolder);
            editingFolder = null;
        }
        else
        {
            var folder = new FolderDto
            {
                Name = newFolder.Name ?? string.Empty,
                Description = newFolder.Description ?? string.Empty,
                CreatedBy = string.IsNullOrWhiteSpace(newFolder.CreatedBy) ? "Neznámý" : newFolder.CreatedBy,
                Files = new List<FileDto>(),
                Links = new List<LinkDto>(),
                StudentMaterials = new List<StudentMaterialDto>()
            };

            await TeachingMaterialsApi.CreateFolderAsync(folder);
        }
        folders = await TeachingMaterialsApi.GetFoldersAsync();
        newFolder = new();
    }

    private void StartEdit(FolderDto folder)
    {
        editingFolder = folder;
        newFolder = new CreateFolderModel
        {
            Name = folder.Name,
            Description = folder.Description,
            CreatedBy = folder.CreatedBy
        };
        selectedMajor = majorsWithSubjects.FirstOrDefault(x => x.Value.Contains(folder.Name)).Key;
    }

    private void CancelEdit()
    {
        editingFolder = null;
        newFolder = new CreateFolderModel();
    }

    private async Task DeleteFolder(FolderDto folder)
    {
        await TeachingMaterialsApi.DeleteFolderAsync(folder);
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private string GetAccentColor(string subject) => subject switch
    {
        "Matematika" => "#fd7e14",
        "Dějepis" => "#6c757d",
        "Fyzika" => "#2274a5",
        "Angličtina" => "#0d6efd",
        "Webové stránky" => "#4285f4",
        "Ekonomika" => "#b02a37",
        _ => "#6c757d"
    };

    private class CreateFolderModel
    {
        [Required(ErrorMessage = "Zadejte název předmětu.")]
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? CreatedBy { get; set; }
    }
}
