@page "/materials"
@using Bookong.Web.Services
@using Bookong.Web.Models
@using System.ComponentModel.DataAnnotations
@inject ITeachingMaterialsApi TeachingMaterialsApi
@inject IJSRuntime JS

<!-- ====================== PAGE HEADER ========================== -->

<div class="materials-hero container py-5 mb-4">
    <div class="d-flex align-items-center justify-content-between">
        <div>
            <h1 class="materials-title mb-1">
                Výukové materiály
                <span class="badge bg-white text-dark ms-2 shadow-sm">
                    @((folders?.Count) ?? 0)
                </span>
            </h1>
            <p class="materials-subtitle mb-0">
                Rychle najděte a spravujte studijní předměty — moderní, čisté a responzivní rozhraní.
            </p>
        </div>

        <div class="hero-buttons d-flex gap-2 align-items-center">
            <button class="btn btn-white-shadow btn-sm" @onclick="NewItem" title="Vytvořit nový předmět">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="me-1">
                    <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Nový
            </button>

            <button class="btn btn-outline-light btn-sm" @onclick="ToggleView" title="Přepnout zobrazení">
                @(compactView ? "Rozšířený" : "Kompaktní")
            </button>
        </div>
    </div>

    <!-- Search + filters -->
    <div class="mt-4 d-flex gap-2 flex-column">
        <div>
            <div class="input-group shadow-sm search-glass">
                <span class="input-group-text bg-transparent border-0">🔍</span>
                <input class="form-control form-control-lg border-0" placeholder="Hledat..." @bind="searchTerm" />
            </div>
        </div>

        @if (!compactView)
        {
            <div class="d-flex gap-2 mt-2 flex-wrap">
                <InputText class="form-control form-control-sm" placeholder="Obor" @bind-Value="filterField" />
                <InputText class="form-control form-control-sm" placeholder="Autor" @bind-Value="filterAuthor" />
                <input type="date" class="form-control form-control-sm" @bind="filterFrom" />
                <input type="date" class="form-control form-control-sm" @bind="filterTo" />
                <button class="btn btn-sm btn-outline-light" @onclick="ApplyFilters">Použít</button>
            </div>
        }
    </div>
</div>

<!-- =========================== BODY ================================ -->

<div class="container">
    <div class="row gy-4">

        <!-- ===================== LEFT SIDE – FORM ======================== -->

        <div class="col-lg-5">
            <div class="card form-card shadow-sm border-0 p-3 mb-3">
                <h5 class="mb-3 text-muted">
                    @(editingFolder is not null ? "Upravit předmět" : "Vytvořit předmět")
                </h5>

                <EditForm Model="formModel" OnValidSubmit="HandleFormSubmit" FormName="CreateMaterialForm">
                    <DataAnnotationsValidator />

                    <!-- Name -->
                    <div class="mb-3">
                        <label class="form-label small">Předmět</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">📘</span>
                            <input class="form-control form-control-lg rounded-pill"
                                   @bind="formModel.Name" placeholder="Název předmětu" @ref="nameInputRef" />
                        </div>
                        <ValidationMessage For="@(() => formModel.Name)" class="text-danger small mt-1" />
                    </div>

                    <!-- Field -->
                    <div class="mb-3">
                        <label class="form-label small">Obor</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">🏷️</span>
                            <InputText class="form-control rounded-pill" @bind-Value="formModel.Field" placeholder="Název oboru" />
                        </div>
                        <ValidationMessage For="@(() => formModel.Field)" class="text-danger small mt-1" />
                    </div>

                    <!-- Author -->
                    <div class="mb-3">
                        <label class="form-label small">Autor</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">👤</span>
                            <InputText class="form-control rounded-pill" @bind-Value="formModel.CreatedBy" placeholder="Vaše jméno" />
                        </div>
                        <ValidationMessage For="@(() => formModel.CreatedBy)" class="text-danger small mt-1" />
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label class="form-label small">Popis</label>
                        <InputTextArea class="form-control" @bind-Value="formModel.Description" placeholder="Krátký popis" rows="4" />
                        <ValidationMessage For="@(() => formModel.Description)" class="text-danger small mt-1" />
                    </div>

                    <!-- URL -->
                    <div class="mb-3">
                        <label class="form-label small">URL odkaz</label>
                        <div class="input-group">
                            <span class="input-group-text icon-left">🔗</span>
                            <InputText class="form-control rounded-pill" @bind-Value="formModel.LinkUrl" placeholder="https://..." />
                        </div>
                        <ValidationMessage For="@(() => formModel.LinkUrl)" class="text-danger small mt-1" />
                    </div>

                    <!-- Submit -->
                    <div class="d-grid">
                        <button class="btn btn-gradient btn-lg rounded-pill" type="submit" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                @(editingFolder != null ? "Ukládám..." : "Vytvářím...")
                            }
                            else
                            {
                                @(editingFolder != null ? "Uložit změny" : "Vytvořit předmět")
                            }
                        </button>
                    </div>

                    @if (editingFolder != null)
                    {
                        <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelEdit">Zrušit</button>
                    }

                    <ValidationSummary class="mt-2 text-danger" />
                </EditForm>
            </div>
        </div>

        <!-- ===================== RIGHT SIDE – LIST ======================= -->

        <div class="col-lg-7">
            <h5 class="mb-3">Vytvořené předměty</h5>

            @if (folders is null)
            {
                <div class="row g-3">
                    @for (int i = 0; i < 4; i++)
                    {
                        <div class="col-sm-6">
                            <div class="card created-card skeleton-card">
                                <div class="card-body p-3">
                                    <div class="skeleton-line short mb-2"></div>
                                    <div class="skeleton-line mid mb-2"></div>
                                    <div class="skeleton-line long"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (FilteredFolders.Count == 0)
            {
                <div class="empty-state card p-4 text-center border-0 shadow-sm">
                    <div class="empty-emoji mb-2">📚</div>
                    <div class="fw-semibold">Zatím žádné předměty</div>
                    <div class="text-muted small">Vytvořte první předmět pomocí formuláře vlevo.</div>
                </div>
            }
            else
            {
                <div class="row g-3 created-list">
                    @foreach (var f in FilteredFolders)
                    {
                        <div class="col-sm-6">
                            <div class="card created-card h-100 shadow-sm border-0">
                                <div class="card-body p-3 d-flex flex-column">

                                    <!-- Header -->
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="card-title mb-1">@f.Name</h6>
                                            <div class="text-muted small">@f.Field</div>
                                        </div>
                                        <small class="text-muted">@f.CreatedBy</small>
                                    </div>

                                    <!-- Description -->
                                    <p class="card-text small text-muted mb-2 text-truncate">@f.Description</p>

                                    <!-- URL + buttons -->
                                    <div class="mt-auto d-flex justify-content-between align-items-center">
                                        <a href="@f.LinkUrl" target="_blank" class="link-primary small text-truncate me-3" title="@f.LinkUrl">
                                            @f.LinkUrl
                                        </a>

                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(f)" title="Upravit">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                                                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" />
                                                    <path d="M20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                                </svg>
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFolder(f)" title="Smazat">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                                                    <path d="M6 6l12 12" />
                                                    <path d="M18 6L6 18" />
                                                </svg>
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Footer -->
                                    <div class="mt-2 d-flex justify-content-between text-muted small">
                                        <span>Vytvořeno: @f.CreatedAt.ToString("dd.MM.yyyy")</span>
                                        <span class="badge bg-light text-dark">Soubory: @(f.Files?.Count ?? 0)</span>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

@code {

    /* ===================== DATA & STATE ====================== */

    private List<FolderDto>? folders;
    private FolderDto? editingFolder;
    private bool isSaving = false;
    private bool compactView = false;
    private string searchTerm = string.Empty;

    private ElementReference nameInputRef;

    private string filterField = string.Empty;
    private string filterAuthor = string.Empty;
    private DateTime? filterFrom;
    private DateTime? filterTo;

    private FormFolderModel formModel = new();

    /* ===================== VALIDATION MODEL ======================= */

    public class FormFolderModel
    {
        [Required(ErrorMessage = "Název předmětu je povinný.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Obor je povinný.")]
        public string? Field { get; set; }

        [Required(ErrorMessage = "Autor je povinný.")]
        public string? CreatedBy { get; set; }

        [Required(ErrorMessage = "Popis je povinný.")]
        public string? Description { get; set; }

        [Required(ErrorMessage = "URL odkaz je povinný.")]
        public string? LinkUrl { get; set; }
    }

    /* ======================== INIT ========================== */

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    /* ======================== FILTERING ========================== */

    private IReadOnlyList<FolderDto> FilteredFolders =>
        (folders ?? new())
        .Where(f =>
            // global search
            (string.IsNullOrWhiteSpace(searchTerm) ||
             (f.Name ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (f.Field ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
             (f.CreatedBy ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase))

            // field filter
            && (string.IsNullOrWhiteSpace(filterField) ||
                (f.Field ?? "").Contains(filterField, StringComparison.OrdinalIgnoreCase))

            // author filter
            && (string.IsNullOrWhiteSpace(filterAuthor) ||
                (f.CreatedBy ?? "").Contains(filterAuthor, StringComparison.OrdinalIgnoreCase))

            // date
            && (!filterFrom.HasValue || f.CreatedAt.Date >= filterFrom.Value.Date)
            && (!filterTo.HasValue || f.CreatedAt.Date <= filterTo.Value.Date)
        )
        .ToList();

    private void ApplyFilters() { /* optional */ }

    /* ======================== FORM LOGIC ========================== */

    private async Task HandleFormSubmit()
    {
        if (isSaving) return;

        isSaving = true;

        try
        {
            if (editingFolder != null)
            {
                // edit
                editingFolder.Name = formModel.Name!;
                editingFolder.Field = formModel.Field!;
                editingFolder.Description = formModel.Description!;
                editingFolder.CreatedBy = formModel.CreatedBy!;
                editingFolder.LinkUrl = formModel.LinkUrl!;
                editingFolder.CreatedAt = DateTime.Now;

                await TeachingMaterialsApi.UpdateFolderAsync(editingFolder);
                editingFolder = null;
            }
            else
            {
                // create
                var folder = new FolderDto
                {
                    Name = formModel.Name!,
                    Field = formModel.Field!,
                    Description = formModel.Description!,
                    CreatedBy = formModel.CreatedBy!,
                    LinkUrl = formModel.LinkUrl!,
                    Files = new List<FileDto>(),
                    Links = new List<LinkDto>(),
                    StudentMaterials = new List<StudentMaterialDto>(),
                    CreatedAt = DateTime.Now
                };

                await TeachingMaterialsApi.CreateFolderAsync(folder);
            }

            folders = await TeachingMaterialsApi.GetFoldersAsync();
            searchTerm = string.Empty;
            formModel = new();

        }
        finally
        {
            isSaving = false;
        }
    }

    private void StartEdit(FolderDto folder)
    {
        editingFolder = folder;
        formModel = new FormFolderModel
        {
            Name = folder.Name,
            Field = folder.Field,
            Description = folder.Description,
            CreatedBy = folder.CreatedBy,
            LinkUrl = folder.LinkUrl
        };
    }

    private void CancelEdit()
    {
        editingFolder = null;
        formModel = new();
    }

    private async Task DeleteFolder(FolderDto folder)
    {
        await TeachingMaterialsApi.DeleteFolderAsync(folder);
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private void ToggleView() => compactView = !compactView;

    private async Task NewItem()
    {
        editingFolder = null;
        formModel = new();

        await Task.Yield();

        try
        {
            await JS.InvokeVoidAsync("blazorHelpers.focusAndScroll", nameInputRef);
        }
        catch { }
    }
}
