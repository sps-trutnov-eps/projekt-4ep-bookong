@page "/teaching-materials"
@inject ITeachingMaterialsApi TeachingMaterialsApi

<h1>Výukové materiály</h1>
<div class="container">
    <div class="row">
        <div class="col-4">
            <ul class="list-group">
                @if (folders != null)
                {
                    foreach (var f in folders)
                    {
                        <li class="list-group-item @(selectedFolder == f ? "active" : "")"
                            @onclick="@(() => SelectFolder(f))">
                            @f.Name
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item">Načítám složky...</li>
                }
            </ul>
        </div>

        <div class="col-8">
            @if (selectedFolder != null)
            {
                <h2>@selectedFolder.Name</h2>
                <p>@selectedFolder.Description</p>
                <p><b>Založil:</b> @selectedFolder.CreatedBy</p>

                <h4>Soubory</h4>
                
                <ul>
                    @foreach (var file in selectedFolder.Files)
                    {
                        <li>@file.FileName (@file.FileType)</li>
                    }
                </ul>
                

                <h4>Odkazy</h4>
                <ul>
                    @foreach (var link in selectedFolder.Links)
                    {
                        <li><a href="@link.Url" target="_blank">@link.Name</a></li>
                    }
                </ul>

                <h4>Materiály pro žáky</h4>
                <ul>
                    @foreach (var material in selectedFolder.StudentMaterials)
                    {
                        <li>@material.Title – @material.Description</li>
                    }
                </ul>
                
            }
            else
            {
                <p>Vyberte složku pro zobrazení detailů.</p>
            }
        </div>
    </div>
</div>

@code {
    private List<FolderDto> folders;
    private FolderDto selectedFolder;

    protected override async Task OnInitializedAsync()
    {
        folders = await TeachingMaterialsApi.GetFoldersAsync();
    }

    private void SelectFolder(FolderDto f)
    {
        selectedFolder = f;
    }

    // Modely 
    public class FolderDto
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public string CreatedBy { get; set; }
        public List<FileDto> Files { get; set; }
        public List<LinkDto> Links { get; set; }
        public List<StudentMaterialDto> StudentMaterials { get; set; }
    }
    public class FileDto
    {
        public string FileName { get; set; }
        public string FileType { get; set; }
        
    }
    public class LinkDto
    {
        public string Name { get; set; }
        public string Url { get; set; }
    }
    public class StudentMaterialDto
    {
        public string Title { get; set; }
        public string Description { get; set; }
    }
}
