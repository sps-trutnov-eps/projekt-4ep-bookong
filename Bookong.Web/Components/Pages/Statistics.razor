@using Bookong.Web.Components.Layout
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.DTOs
@page "/statistics"
@layout MainLayout
@inject IJSRuntime JS
@inject IGetLibraryStatisticsQuery LibraryStatsQuery

<!-- Hero Section with white background -->
<div class="bg-white pb-5" style="min-height: 80vh;">
    <div class="container px-4 text-center pt-5">
        <!-- Welcome Message -->
        <h1 class="fw-bold text-primary mb-3" style="font-size: 3rem; letter-spacing: -0.02em;">
            Statistiky knihovny
        </h1>
        <p class="lead text-muted mb-4" style="font-size: 1.1rem;">
            Přehled čtenářů, výpůjček a oblíbených knih
        </p>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Načítání...</span>
                </div>
            </div>
        }
        else if (stats != null)
        {
            <!-- Statistické karty -->
            <div class="row g-4 justify-content-center mb-5">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 text-center border-0 shadow-lg" style="transition: transform 0.3s ease;">
                        <div class="card-body d-flex flex-column align-items-center p-4">
                            <div class="d-flex align-items-center justify-content-center rounded-circle mb-3"
                                 style="width: 4rem; height: 4rem; background: linear-gradient(135deg, #0a4db8, #083d96);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" viewBox="0 0 16 16">
                                    <path d="M10 5a2 2 0 1 1-4 0 2 2 0 0 1 4 0z" />
                                    <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-7 7 7 7 0 0 0 14 0A7 7 0 0 0 8 1z" />
                                </svg>
                            </div>
                            <h3 class="card-title h6 fw-bold mb-2 text-primary">Počet čtenářů</h3>
                            <p class="card-text flex-grow-1 mb-0 text-muted fs-4 fw-semibold">@stats.TotalUsers</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 text-center border-0 shadow-lg" style="transition: transform 0.3s ease;">
                        <div class="card-body d-flex flex-column align-items-center p-4">
                            <div class="d-flex align-items-center justify-content-center rounded-circle mb-3"
                                 style="width: 4rem; height: 4rem; background: linear-gradient(135deg, #0a4db8, #083d96);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" viewBox="0 0 16 16">
                                    <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828z" />
                                    <path d="M8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z" />
                                </svg>
                            </div>
                            <h3 class="card-title h6 fw-bold mb-2 text-primary">Aktivní výpůjčky</h3>
                            <p class="card-text flex-grow-1 mb-0 text-muted fs-4 fw-semibold">@stats.ActiveLoans</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 text-center border-0 shadow-lg" style="transition: transform 0.3s ease;">
                        <div class="card-body d-flex flex-column align-items-center p-4">
                            <div class="d-flex align-items-center justify-content-center rounded-circle mb-3"
                                 style="width: 4rem; height: 4rem; background: linear-gradient(135deg, #0a4db8, #083d96);">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" viewBox="0 0 16 16">
                                    <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828z" />
                                    <path d="M8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z" />
                                </svg>
                            </div>
                            <h3 class="card-title h6 fw-bold mb-2 text-primary">Knih v knihovně</h3>
                            <p class="card-text flex-grow-1 mb-0 text-muted fs-4 fw-semibold">@stats.TotalBooksInLibrary</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sekce Top 5 knih za poslední měsíc -->
            <div class="row justify-content-center g-4 mb-4">
                <div class="col-lg-6 col-md-10">
                    <div class="card shadow-lg border-0 p-4">
                        <h5 class="fw-bold text-primary mb-4 text-center">
                            Top 5 knih za poslední měsíc
                        </h5>

                        @if (stats.TopBooksLastMonth.Any())
                        {
                            <!-- Tabulka -->
                            <table class="table table-striped mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 10%;">#</th>
                                        <th style="width: 50%;">Kniha</th>
                                        <th style="width: 25%;">Autor</th>
                                        <th style="width: 15%;" class="text-center">Výpůjčky</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < stats.TopBooksLastMonth.Count; i++)
                                    {
                                        var book = stats.TopBooksLastMonth[i];
                                        <tr>
                                            <td class="text-center fw-bold">@(i + 1)</td>
                                            <td>@book.BookTitle</td>
                                            <td class="text-muted small">@book.AuthorName</td>
                                            <td class="text-center">
                                                <span class="badge bg-primary">@book.LoanCount</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-center text-muted">Žádné výpůjčky za poslední měsíc</p>
                        }
                    </div>
                </div>

                <div class="col-lg-6 col-md-10">
                    <div class="card shadow-lg border-0 p-4">
                        <h5 class="fw-bold text-primary mb-4 text-center">
                            Další statistiky
                        </h5>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
                                    <span class="fw-semibold">Nejoblíbenější kniha</span>
                                    <span class="text-muted">@(string.IsNullOrEmpty(stats.MostPopularBook) ? "—" : stats.MostPopularBook)</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
                                    <span class="fw-semibold">Nejoblíbenější autor</span>
                                    <span class="text-muted">@(string.IsNullOrEmpty(stats.MostPopularAuthor) ? "—" : stats.MostPopularAuthor)</span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
                                    <span class="fw-semibold">Nejoblíbenější žánr</span>
                                    <span class="text-muted">@(string.IsNullOrEmpty(stats.MostPopularGenre) ? "—" : stats.MostPopularGenre)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Nepodařilo se načíst statistiky.
            </div>
        }
    </div>
</div>

<!-- Wave Container -->
<div class="position-relative w-100 overflow-hidden" style="line-height: 0;">
    <!-- Primary Wave -->
    <svg class="w-100 d-block" style="height: 5rem;" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 C300,80 900,0 1200,80 L1200,120 L0,120 Z" fill="#0a4db8"></path>
    </svg>
    <!-- Secondary Wave -->
    <svg class="w-100 d-block" style="height: 5rem; margin-top: -0.25rem; background-color: #0a4db8;" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,0 C400,60 800,0 1200,60 L1200,120 L0,120 Z" fill="#083d96"></path>
    </svg>
</div>

@code {
    private LibraryStatisticsDto? stats;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            stats = await LibraryStatsQuery.ExecuteAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading statistics: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}