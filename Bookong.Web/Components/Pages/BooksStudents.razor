@using Bookong.Web.Components.Layout
@using Bookong.Domain.Entities

@page "/booksstudents"
@layout MainLayout

<PageTitle>Vyhledávání knih - BooKong</PageTitle>

<!-- Main: Search and Results -->
<main class="container my-5 flex-grow-1">
  <div class="w-100" style="max-width: 1200px; margin: 0 auto;">
    <h2 class="mb-4 text-primary text-center">Vyhledávání knih</h2>

    <!-- Search Form -->
    <form @onsubmit="SearchBooks" class="mb-4">
      <div class="row g-3">
        <div class="col-md-3">
          <input type="text" class="form-control" @bind="searchCriteria.Title" placeholder="Název knihy" />
        </div>
        <div class="col-md-3">
          <input type="text" class="form-control" @bind="searchCriteria.Author" placeholder="Autor" />
        </div>
        <div class="col-md-3">
          <input type="text" class="form-control" @bind="searchCriteria.Genre" placeholder="Žánr" />
        </div>
        <div class="col-md-3">
          <button type="submit" class="btn btn-primary w-100">Hledat</button>
        </div>
      </div>
    </form>

    <!-- Results Table -->
    @if (isLoading)
    {
      <div class="text-center">
        <div class="spinner-border text-primary" role="status">
          <span class="visually-hidden">Načítání...</span>
        </div>
      </div>
    }
    else if (books.Count == 0)
    {
      <p class="text-center text-muted">Žádné knihy nenalezeny.</p>
    }
    else
    {
      <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
          <caption class="text-muted">Výsledky vyhledávání knih</caption>
          <thead class="table-primary">
            <tr>
              <th scope="col">Název</th>
              <th scope="col">Autor</th>
              <th scope="col">Žánr</th>
              <th scope="col">ISBN</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var book in books)
            {
              <tr>
                <td>@book.Name</td>
                <td>@book.Author</td>
                <td>@book.Genre</td>
                <td>@book.ISBN</td>
                <td>
                  @if (book.IsBorrowed)
                  {
                    <span class="badge bg-danger">Vypůjčeno</span>
                  }
                  else
                  {
                    <span class="badge bg-success">Dostupné</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</main>

@code {
  private List<BookViewModel> books = new();
  private bool isLoading = false;
  private SearchCriteria searchCriteria = new();

  private class SearchCriteria
  {
    public string Title { get; set; } = "";
    public string Author { get; set; } = "";
    public string Genre { get; set; } = "";
  }

  private class BookViewModel
  {
    public string? Name { get; set; }
    public string? Author { get; set; }
    public string? Genre { get; set; }
    public string? ISBN { get; set; }
    public bool IsBorrowed { get; set; }
  }

  protected override async Task OnInitializedAsync()
  {
    // Mock data
    var mockBooks = new List<BookViewModel>
    {
      new BookViewModel { Name = "1984", ISBN = "978-0451524935", IsBorrowed = true, Author = "George Orwell", Genre = "Dystopie" },
      new BookViewModel { Name = "To Kill a Mockingbird", ISBN = "978-0061120084", IsBorrowed = false, Author = "Harper Lee", Genre = "Drama" },
      new BookViewModel { Name = "Pride and Prejudice", ISBN = "978-0486284736", IsBorrowed = true, Author = "Jane Austen", Genre = "Romance" },
      new BookViewModel { Name = "The Great Gatsby", ISBN = "978-0743273565", IsBorrowed = false, Author = "F. Scott Fitzgerald", Genre = "Fiction" }
    };

    books = mockBooks;
  }

  private async Task SearchBooks()
  {
    isLoading = true;
    // Simulate search delay
    await Task.Delay(500);

    // Mock filtering
    var mockBooks = new List<BookViewModel>
    {
      new BookViewModel { Name = "1984", ISBN = "978-0451524935", IsBorrowed = true, Author = "George Orwell", Genre = "Dystopie" },
      new BookViewModel { Name = "To Kill a Mockingbird", ISBN = "978-0061120084", IsBorrowed = false, Author = "Harper Lee", Genre = "Drama" },
      new BookViewModel { Name = "Pride and Prejudice", ISBN = "978-0486284736", IsBorrowed = true, Author = "Jane Austen", Genre = "Romance" },
      new BookViewModel { Name = "The Great Gatsby", ISBN = "978-0743273565", IsBorrowed = false, Author = "F. Scott Fitzgerald", Genre = "Fiction" }
    };

    books = mockBooks.Where(b =>
      (string.IsNullOrEmpty(searchCriteria.Title) || (b.Name?.Contains(searchCriteria.Title, StringComparison.OrdinalIgnoreCase) ?? false)) &&
      (string.IsNullOrEmpty(searchCriteria.Author) || (b.Author?.Contains(searchCriteria.Author, StringComparison.OrdinalIgnoreCase) ?? false)) &&
      (string.IsNullOrEmpty(searchCriteria.Genre) || (b.Genre?.Contains(searchCriteria.Genre, StringComparison.OrdinalIgnoreCase) ?? false))
    ).ToList();

    isLoading = false;
  }
}
