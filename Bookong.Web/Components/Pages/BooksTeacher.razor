@page "/booksteacher"
@using Bookong.Application.DTOs
@using Bookong.Application.UseCases.Queries.Interfaces
@using Bookong.Application.UseCases.Interfaces
@inject IGetAllBooksQuery GetAllBooksQuery
@inject IGetMaturitaBooksQuery GetAvailableMaturitaBooksQuery
@inject ICreateMaturitaBookUseCase CreateMaturitaUseCase
@inject IDeleteMaturitaBookUseCase DeleteMaturitaUseCase
@inject IJSRuntime JS

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-6 fw-semibold mb-0">Správa maturitních knih – učitel</h1>
        <button class="btn btn-success">
            + Přidat novou knihu
        </button>
    </div>

    <!-- Filtr (vyhledávání, žánr, typ) -->
    <div class="border rounded-3 shadow-sm bg-body mb-4 p-3">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-6 col-lg-5">
                <label class="form-label">Vyhledávání</label>
                <input class="form-control" placeholder="Zadejte název nebo autora" @bind="tempSearchText" />
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Žánr</label>
                <select class="form-select" @bind="tempSelectedGenre">
                    <option value="">Vše</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g">@g</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label">Typ</label>
                <select class="form-select" @bind="tempSelectedKind">
                    <option value="">Vše</option>
                    @foreach (var k in kinds)
                    {
                        <option value="@k">@k</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-12 col-lg-3 d-grid d-md-flex gap-2 justify-content-end">
                <button class="btn btn-primary" @onclick="ApplyFilters">Filtrovat</button>
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Vymazat filtr</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Načítání...</span>
            </div>
        </div>
    }
    else if (filteredBooks == null || !filteredBooks.Any())
    {
        <div class="text-center">
            <p class="text-muted mb-3">Žádné knihy k zobrazení.</p>
        </div>
    }
    else
    {
        <div class="border rounded-3 shadow-sm bg-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Název knihy</th>
                            <th>Autor</th>
                            <th>Žánr</th>
                            <th>Typ</th>
                            <th class="text-center" style="width:320px;">Akce</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var book in filteredBooks)
                        {
                            var isAvailable = IsBookAvailable(book);
                            <tr>
                                <td>@book.Title</td>
                                <td>@book.AuthorFullName</td>
                                <td>@book.Genre</td>
                                <td>@book.Kind</td>
                                <td class="text-center">
                                    <div class="d-flex gap-2 justify-content-center flex-nowrap">
                                        <button class="btn btn-outline-success btn-sm"
                                                disabled="@(isProcessing && processingBookId == book.PublicId)"
                                                @onclick="() => ToggleAvailableAsync(book.PublicId)">
                                            @if (isProcessing && processingBookId == book.PublicId)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                                <span class="ms-1">Zpracovávám...</span>
                                            }
                                            else
                                            {
                                                @(isAvailable ? "Odebrat z dostupných" : "Přidat do dostupných")
                                            }
                                        </button>
                                        <button class="btn btn-outline-primary btn-sm">Upravit</button>
                                        <button class="btn btn-outline-danger btn-sm">Odebrat</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<BookListItemDto>? books;
    private List<BookListItemDto> filteredBooks = new();
    private HashSet<string> availableBookKeys = new();

    private bool isLoading = true;
    private bool isProcessing;
    private Guid processingBookId;
    private string? errorMessage;
    private string? successMessage;

    // Temporary filter inputs
    private string tempSearchText = "";
    private string? tempSelectedGenre;
    private string? tempSelectedKind;

    // Applied filters
    private string searchText = "";
    private string? selectedGenre;
    private string? selectedKind;

    private List<string> genres = new();
    private List<string> kinds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;

            // Load all books
            books = (await GetAllBooksQuery.ExecuteAsync()).ToList();

            // Load available books and create composite keys
            var availableBooks = await GetAvailableMaturitaBooksQuery.ExecuteAsync();
            availableBookKeys = availableBooks
                .Select(b => GetBookKey(b.Title, b.AuthorFullName, b.GenreName, b.KindName))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            // Populate filter options
            genres = books
                .Where(b => !string.IsNullOrWhiteSpace(b.Genre))
                .Select(b => b.Genre!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(g => g)
                .ToList();

            kinds = books
                .Where(b => !string.IsNullOrWhiteSpace(b.Kind))
                .Select(b => b.Kind!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(k => k)
                .ToList();

            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = "Nepodařilo se načíst seznam knih.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetBookKey(string? title, string? author, string? genre, string? kind)
    {
        return $"{title?.Trim()}|{author?.Trim()}|{genre?.Trim()}|{kind?.Trim()}".ToLowerInvariant();
    }

    private bool IsBookAvailable(BookListItemDto book)
    {
        var key = GetBookKey(book.Title, book.AuthorFullName, book.Genre, book.Kind);
        return availableBookKeys.Contains(key);
    }

    private async Task ToggleAvailableAsync(Guid bookPublicId)
    {
        if (isProcessing) return;

        try
        {
            isProcessing = true;
            processingBookId = bookPublicId;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var book = books?.FirstOrDefault(b => b.PublicId == bookPublicId);
            if (book == null) return;

            GenericResponse result;
            bool isCurrentlyAvailable = IsBookAvailable(book);

            if (isCurrentlyAvailable)
            {
                var ok = await JS.InvokeAsync<bool>("confirm", "Opravdu chcete odebrat knihu z dostupných?");
                if (!ok) return;

                result = await DeleteMaturitaUseCase.RemoveFromAvailableAsync(bookPublicId);
            }
            else
            {
                result = await CreateMaturitaUseCase.AddToAvailableAsync(bookPublicId);
            }

            if (result.Success)
            {
                successMessage = result.Message;
                
                // Reload available books and create composite keys
                var availableBooks = await GetAvailableMaturitaBooksQuery.ExecuteAsync();
                availableBookKeys = availableBooks
                    .Select(b => GetBookKey(b.Title, b.AuthorFullName, b.GenreName, b.KindName))
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Došlo k chybě při zpracování požadavku.";
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void ApplyFilters()
    {
        searchText = tempSearchText;
        selectedGenre = tempSelectedGenre;
        selectedKind = tempSelectedKind;

        if (books == null)
        {
            filteredBooks = new();
            return;
        }

        var query = books.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim().ToLower();
            query = query.Where(b =>
                (!string.IsNullOrWhiteSpace(b.Title) && b.Title.ToLower().Contains(s)) ||
                (!string.IsNullOrWhiteSpace(b.AuthorFullName) && b.AuthorFullName.ToLower().Contains(s))
            );
        }

        if (!string.IsNullOrWhiteSpace(selectedGenre))
            query = query.Where(b => string.Equals(b.Genre, selectedGenre, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(selectedKind))
            query = query.Where(b => string.Equals(b.Kind, selectedKind, StringComparison.OrdinalIgnoreCase));

        filteredBooks = query.ToList();
        StateHasChanged();
    }

    private void ClearFilters()
    {
        tempSearchText = "";
        tempSelectedGenre = null;
        tempSelectedKind = null;

        searchText = "";
        selectedGenre = null;
        selectedKind = null;

        ApplyFilters();
    }
}