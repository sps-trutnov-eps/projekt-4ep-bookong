@page "/login"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Bookong.Application.DTOs
@inject Bookong.Application.UseCases.Interfaces.ILoginUserUseCase LoginUserUseCase
@inject Bookong.Application.Services.Interfaces.ISessionService SessionService
@inject NavigationManager Navigation

<div class="login-wrapper d-flex flex-column align-items-center justify-content-center text-center">

   <div class="card shadow-sm p-4 login-card">
   <h3 class="mb-4">Přihlášení do systému</h3>

      <EditForm Model="loginModel" OnValidSubmit="LoginUserAsync">
       <DataAnnotationsValidator />
  
  @if (!string.IsNullOrEmpty(debugMessage))
     {
      <div class="alert @(isError ? "alert-danger" : "alert-info")" role="alert">
            @debugMessage
        </div>
     }

    <div class="mb-3 text-start">
      <label class="form-label">Uživatelské jméno</label>
    <InputText @bind-Value="loginModel.Username" class="form-control" />
     <ValidationMessage For="@(() => loginModel.Username)" />
            </div>

  <div class="mb-3 text-start">
          <label class="form-label">Heslo</label>
    <InputText @bind-Value="loginModel.Password" class="form-control" type="password" />
            <ValidationMessage For="@(() => loginModel.Password)" />
      </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    <span>Přihlašování...</span>
                }
                else
                {
                    <span>Přihlásit se</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel { get; set; } = new();
    private string? debugMessage;
    private bool isError = false;
    private bool isLoading = false;

    private async Task LoginUserAsync()
    {
        isLoading = true;
        isError = false;
        debugMessage = null;

        try
        {
            var request = new LoginUserRequest
            {
                Email = loginModel.Username,
                Password = loginModel.Password
            };

            var response = await LoginUserUseCase.ExecuteAsync(request);

            if (response.UserId != Guid.Empty)
            {
                await SessionService.SetAsync("CurrentUserPublicId", response.UserId.ToString());
                Navigation.NavigateTo("/portalpage", forceLoad: true);
            }
            else
            {
                debugMessage = response.Message;
                isError = true;
            }
        }
        catch (Exception ex)
        {
            debugMessage = $"Chyba při přihlašování: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Uživatelské jméno je povinné.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Heslo je povinné.")]
        public string Password { get; set; } = string.Empty;
    }
}
