<header class="sticky-top bg-primary">
    <nav class="navbar navbar-dark container-fluid px-2 px-md-3">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <!-- Logo + Název -->
            <NavLink href="/" class="navbar-brand d-flex align-items-center gap-2 me-auto" Match="NavLinkMatch.All">
                <img src="bookong-monke-book.png" alt="BooKong Logo" 
                     class="d-inline-block align-text-top" 
                     style="height: 32px; width: auto;" />
                <span class="fw-bold fs-5 mb-0 text-white d-none d-sm-inline">BooKong</span>
                <span class="fw-bold fs-6 mb-0 text-white d-inline d-sm-none">BK</span>
            </NavLink>

            <!-- Desktop Navigation (hidden on mobile) -->
            <ul class="navbar-nav d-none d-lg-flex flex-row gap-3 mb-0">
                <li class="nav-item">
                    <NavLink href="/" class="nav-link text-white fw-medium px-2 py-2 rounded hover-bg-light" Match="NavLinkMatch.All">Domů</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink href="/uzivatele" class="nav-link text-white fw-medium px-2 py-2 rounded hover-bg-light">Uživatelé</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink href="/knihy" class="nav-link text-white fw-medium px-2 py-2 rounded hover-bg-light">Knihy</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink href="/seznamy" class="nav-link text-white fw-medium px-2 py-2 rounded hover-bg-light">Seznamy</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink href="/statistiky" class="nav-link text-white fw-medium px-2 py-2 rounded hover-bg-light">Statistiky</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink href="/vypujcky" class="nav-link text-white fw-medium px-2 py-2 rounded hover-bg-light">Výpůjčky</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink href="/materialy" class="nav-link text-white fw-medium px-2 py-2 rounded hover-bg-light">Materiály</NavLink>
                </li>
            </ul>

            <!-- Burger menu button (visible on mobile/tablet) -->
            <button class="navbar-toggler d-lg-none border-0 p-2" type="button" id="menuToggle"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <!-- Full-screen overlay menu -->
    <div class="overlay-menu" id="overlayMenu">
        <!-- Header with BooKong title and close button -->
        <div class="overlay-header">
            <div class="overlay-title">
                <img src="bookong-monke-book.png" alt="BooKong Logo" />
                <span>BooKong</span>
            </div>
            <button class="close-btn" id="closeMenu" aria-label="Close menu">
                <span>&times;</span>
            </button>
        </div>
        
        <div class="overlay-content">
            <!-- Welcome text -->
            <div class="overlay-welcome">
                Vítejte v našem školním knihovním systému
            </div>
            
            <!-- Navigation Links -->
            <nav class="overlay-nav">
                <ul class="overlay-nav-list nav flex-column text-center">
                    <li class="nav-item"><NavLink href="/" class="nav-link text-white fw-medium py-2" Match="NavLinkMatch.All">Domů</NavLink></li>
                    <li class="nav-item"><NavLink href="/uzivatele" class="nav-link text-white fw-medium py-2">Uživatelé</NavLink></li>
                    <li class="nav-item"><NavLink href="/knihy" class="nav-link text-white fw-medium py-2">Knihy</NavLink></li>
                    <li class="nav-item"><NavLink href="/seznamy" class="nav-link text-white fw-medium py-2">Seznamy</NavLink></li>
                    <li class="nav-item"><NavLink href="/statistiky" class="nav-link text-white fw-medium py-2">Statistiky</NavLink></li>
                    <li class="nav-item"><NavLink href="/vypujcky" class="nav-link text-white fw-medium py-2">Výpůjčky</NavLink></li>
                    <li class="nav-item"><NavLink href="/materialy" class="nav-link text-white fw-medium py-2">Materiály</NavLink></li>
                </ul>
            </nav>
        </div>
        
        <!-- Footer decoration -->
        <div class="overlay-footer">
            <span class="text-white">Školní knihovna • 2025</span>
        </div>
    </div>
</header>
